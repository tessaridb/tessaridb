# Edges and traversal. An edge is a record and traversal is an index read, so
# every case here is exercising machinery the other corpora already cover — which
# is the point of the design.

--- case: the tenancy this file works in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE social;
USE DATABASE social;
DEFINE COLLECTION users;
DEFINE TABLE follows EDGE;
CREATE users:1 = { handle: 'ada' };
CREATE users:2 = { handle: 'grace' };
CREATE users:3 = { handle: 'katherine' };
--- expect: ok

--- case: an edge is written between two records
RELATE users:1->follows->users:2;
RELATE users:1->follows->users:3;
--- expect: ok

--- case: an edge may carry properties of its own
RELATE users:2->follows->users:3 = { since: datetime '2026-01-01T00:00:00Z' };
--- expect: ok

--- case: one arrow reads the edges themselves
SELECT * FROM users:1->follows;
--- expect: rows 2

--- case: two arrows resolve the far endpoint
SELECT * FROM users:1->follows->users;
--- expect: rows 2

--- case: the other direction asks the mirrored question
SELECT * FROM users:3<-follows<-users;
--- expect: rows 2

--- case: a record nobody follows has no incoming edges
SELECT * FROM users:1<-follows<-users;
--- expect: rows 0

--- case: RELATE is idempotent, because an edge is identified by its endpoints
RELATE users:1->follows->users:2;
SELECT * FROM users:1->follows;
--- expect: rows 2

--- case: a deleted endpoint drops out of the traversal rather than failing it
DELETE users:3;
SELECT * FROM users:1->follows->users;
--- expect: rows 1

--- case: the edge itself survives its dangling endpoint
SELECT * FROM users:1->follows;
--- expect: rows 2

# Chains. `users:3` was deleted above and its edges remain, so the graph these
# cases walk is: 1 -> 2, 1 -> 3 (dangling), 2 -> 3 (dangling).

--- case: a graph worth walking more than one hop of
CREATE users:3 = { handle: 'katherine' };
CREATE users:4 = { handle: 'dorothy' };
RELATE users:3->follows->users:4;
--- expect: ok

--- case: two hops answer with the far side of the second
SELECT * FROM users:1->follows->users->follows->users;
--- expect: rows 2

--- case: a chain may stop on the edges of its last step
SELECT * FROM users:1->follows->users->follows;
--- expect: rows 2

--- case: three hops are not a special case of two
SELECT * FROM users:1->follows->users->follows->users->follows->users;
--- expect: rows 1

--- case: the arrows of a chain all point the same way
SELECT * FROM users:1->follows->users<-follows<-users;
--- expect: error UnexpectedToken

--- case: relating through a table that is not an edge table is refused
RELATE users:1->users->users:2;
--- expect: error NotAnEdgeTable

--- case: traversing a table that is not an edge table is refused
SELECT * FROM users:1->users;
--- expect: error NotAnEdgeTable

--- case: an edge table may name the pair it joins
DEFINE COLLECTION posts;
DEFINE TABLE wrote EDGE FROM users TO posts;
CREATE posts:1 = { title: 'first' };
--- expect: ok

--- case: a relation between the declared pair is accepted
RELATE users:1->wrote->posts:1;
--- expect: ok

--- case: a relation between a pair the table does not declare is refused
RELATE users:1->wrote->users:2;
--- expect: error EndpointsNotDeclared

--- case: the direction is part of the declaration, so the reverse pair is refused too
RELATE posts:1->wrote->users:1;
--- expect: error EndpointsNotDeclared

--- case: the bare EDGE table still accepts the pair the declared one refuses
RELATE users:1->follows->users:2;
--- expect: ok

--- case: an endpoint naming no table refuses and leaves nothing behind
DEFINE TABLE mentions EDGE FROM users TO nowhere;
--- expect: error Unknown

--- case: and the refused declaration created no table
RELATE users:1->mentions->posts:1;
--- expect: error Unknown

--- case: a graph is an object the store holds
DEFINE GRAPH social;
--- expect: ok

--- case: a graph with no members reports rather than refusing
INFO FOR GRAPH social;
--- expect: ok

--- case: a table declares which graph it belongs to
DEFINE TABLE person (name string) IN social;
CREATE person:'alice' = { name: 'Alice' };
--- expect: ok

--- case: and a node table is read the way any other table is
SELECT * FROM person WHERE name = 'Alice';
--- expect: rows 1

--- case: a membership naming no graph is refused
DEFINE TABLE ghost (name string) IN nowhere;
--- expect: error Unknown

--- case: and the refused declaration created no table
SELECT * FROM ghost;
--- expect: error Unknown

--- case: a graph refuses to be dropped while a table still belongs to it
DROP GRAPH social;
--- expect: error StillDepended

--- case: and succeeds once nothing does
DROP TABLE person;
DROP GRAPH social;
--- expect: ok

--- case: asking about a graph that was never declared refuses
INFO FOR GRAPH social;
--- expect: error Unknown

# The graph engine. An edge kind is not a table: its entries are adjacency keys
# beside the node, so a hop is a range read rather than an index probe followed
# by a random read of every edge record.

--- case: a graph with two node kinds to join
DEFINE GRAPH org;
DEFINE TABLE employee (name string) IN org;
DEFINE TABLE employer (name string) IN org;
CREATE employee:1 = { name: 'Ada' };
CREATE employee:2 = { name: 'Grace' };
CREATE employer:1 = { name: 'Analytical' };
--- expect: ok

--- case: an edge kind is declared between a pair that belongs to the graph
DEFINE EDGE works_at IN org FROM employee TO employer;
--- expect: ok

--- case: an endpoint outside the graph is refused, because that is what bounds a walk
DEFINE EDGE audited IN org FROM employee TO users;
--- expect: error EndpointOutsideGraph

--- case: a relation between the declared pair is accepted
RELATE employee:1->works_at->employer:1;
RELATE employee:2->works_at->employer:1;
--- expect: ok

--- case: one arrow reads the edges themselves
SELECT * FROM employee:1->works_at;
--- expect: rows 1

--- case: two arrows resolve the far endpoint
SELECT * FROM employee:1->works_at->employer;
--- expect: rows 1

--- case: the reverse direction is a range read too, not a scan of everything
SELECT * FROM employer:1<-works_at<-employee;
--- expect: rows 2

--- case: a node nothing reaches has an empty neighbourhood rather than an error
CREATE employer:2 = { name: 'Naval' };
SELECT * FROM employer:2<-works_at<-employee;
--- expect: rows 0

--- case: a relation off the declared pair is refused
RELATE employee:1->works_at->employee:2;
--- expect: error EndpointsNotDeclared

--- case: and the reverse pair is refused too, because direction is declared
RELATE employer:1->works_at->employee:1;
--- expect: error EndpointsNotDeclared

--- case: relating the same pair twice replaces rather than doubles
RELATE employee:1->works_at->employer:1;
SELECT * FROM employee:1->works_at;
--- expect: rows 1

--- case: an edge of a declared kind carries properties of its own
RELATE employee:2->works_at->employer:1 = { since: 1943 };
SELECT * FROM employer:1<-works_at;
--- expect: rows 2

--- case: a graph lists its edge kinds
INFO FOR GRAPH org;
--- expect: ok

--- case: a graph refuses to be dropped while an edge kind belongs to it
DROP GRAPH org;
--- expect: error StillDepended

--- case: dropping the kind takes its adjacency with it
DROP EDGE works_at;
SELECT * FROM employee:1->works_at;
--- expect: error Unknown

--- case: and dropping an edge kind that was never declared refuses
DROP EDGE works_at;
--- expect: error Unknown
