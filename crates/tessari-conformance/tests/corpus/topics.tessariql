# Topics: an append-only order of messages whose readers keep their positions.

--- case: the tenancy this file works in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE events;
USE DATABASE events;
DEFINE TOPIC orders;
--- expect: ok

--- case: a message is appended with CREATE and INSERT
CREATE orders:'o1' = { total: 10 };
INSERT INTO orders (total) VALUES (20), (30);
READ FROM orders;
--- expect: rows 3

--- case: a read after a position answers what follows it
READ FROM orders AFTER 2;
--- expect: rows 1

--- case: a limit bounds the read
READ FROM orders LIMIT 2;
--- expect: rows 2

--- case: a reader is given the messages after its own position
READ FROM orders FOR CONSUMER 'billing' LIMIT 2;
READ FROM orders FOR CONSUMER 'billing';
--- expect: rows 1

--- case: and nothing once it has been given everything
READ FROM orders FOR CONSUMER 'billing';
--- expect: rows 0

--- case: another reader starts from the beginning
READ FROM orders FOR CONSUMER 'audit';
--- expect: rows 3

--- case: a message is never rewritten
UPDATE orders:'o1' SET total = 11;
--- expect: error TopicIsAppendOnly

--- case: and never deleted by a caller
DELETE orders:'o1';
--- expect: error TopicIsAppendOnly

--- case: an identity is appended once
CREATE orders:'o1' = { total: 12 };
--- expect: error RecordExists

--- case: a message larger than the topic takes is refused
DEFINE TOPIC small MAX BYTES 16;
CREATE small = { text: 'a message well past sixteen bytes' };
--- expect: error TopicMessageTooLarge

--- case: a plain table is not a topic
DEFINE TABLE plain SCHEMALESS;
READ FROM plain;
--- expect: error NotATopic

--- case: a position is a whole number
READ FROM orders AFTER 'first';
--- expect: error InvalidPosition

--- case: a topic open to anyone must bound a message's size
DEFINE TOPIC open PUBLIC RATE 10 PER 1m;
--- expect: error UnexpectedToken

--- case: a topic may not keep messages for no time
DEFINE TOPIC none RETAIN 0s;
--- expect: error UnexpectedToken

--- case: a group shares a topic's messages and acknowledges each one
DEFINE TOPIC jobs;
CREATE jobs:'j1' = { n: 1 };
CREATE jobs:'j2' = { n: 2 };
CREATE jobs:'j3' = { n: 3 };
DEFINE GROUP 'workers' ON TOPIC jobs ACK DEADLINE 30s IN FLIGHT 2;
READ FROM jobs FOR CONSUMER 'workers' LIMIT 10;
--- expect: rows 2

--- case: a group holds no more than it may have in flight
READ FROM jobs FOR CONSUMER 'workers' LIMIT 10;
--- expect: rows 0

--- case: an acknowledgement answers how many messages it settled
ACK jobs FOR CONSUMER 'workers' AT 1, 2;
--- expect: value 2

--- case: and the group moves on to the next message
READ FROM jobs FOR CONSUMER 'workers' LIMIT 10;
--- expect: rows 1

--- case: a negative acknowledgement hands the message out again
NACK jobs FOR CONSUMER 'workers' AT 3;
READ FROM jobs FOR CONSUMER 'workers' LIMIT 10;
--- expect: rows 1

--- case: a group can be moved back to a position
ALTER GROUP 'workers' ON TOPIC jobs START AT 0;
READ FROM jobs FOR CONSUMER 'workers' LIMIT 10;
--- expect: rows 2

--- case: a group of that name already exists
DEFINE GROUP 'workers' ON TOPIC jobs ACK DEADLINE 30s;
--- expect: error GroupExists

--- case: a reader without a group has nothing to acknowledge
ACK jobs FOR CONSUMER 'nobody' AT 1;
--- expect: error NotAGroup

--- case: a member cannot skip the group's work
READ FROM jobs FOR CONSUMER 'workers' AFTER 2;
--- expect: error AfterOnGroup

--- case: a topic cannot be its own group's dead letter
DEFINE GROUP 'loop' ON TOPIC jobs ACK DEADLINE 30s DELIVERIES 3 DEAD LETTER TO jobs;
--- expect: error DeadLetterIsTheTopic

--- case: a group is dropped
DROP GROUP 'workers' ON TOPIC jobs;
--- expect: ok

--- case: and a group that is not there cannot be
DROP GROUP 'workers' ON TOPIC jobs;
--- expect: error NoSuchGroup

--- case: a group must say how long a reader has
DEFINE GROUP 'late' ON TOPIC jobs IN FLIGHT 2;
--- expect: error UnexpectedToken

--- case: a topic consumer reads a topic into a table through a group
DEFINE TOPIC feed;
DEFINE TOPIC feed_dead;
DEFINE COLLECTION feed_rows;
DEFINE GROUP 'rows' ON TOPIC feed ACK DEADLINE 30s DELIVERIES 3 DEAD LETTER TO feed_dead;
DEFINE TOPIC CONSUMER feed_in FROM feed GROUP 'rows' INTO feed_rows IDENTITY order_id MAP amount AS total ON FAILURE quarantine;
--- expect: ok

--- case: quarantine hands a message back, so the group must be able to park it
DEFINE GROUP 'plain' ON TOPIC feed ACK DEADLINE 30s;
DEFINE TOPIC CONSUMER parked_nowhere FROM feed GROUP 'plain' INTO feed_rows IDENTITY order_id MAP amount AS total ON FAILURE quarantine;
--- expect: error QuarantineNeedsDeadLetter

--- case: a topic consumer is not a Kafka consumer
DROP KAFKA CONSUMER feed_in;
--- expect: error WrongConsumerKind

--- case: a topic consumer is dropped by its own words
DROP TOPIC CONSUMER feed_in;
--- expect: ok

--- case: and one that is not there cannot be
DROP TOPIC CONSUMER feed_in;
--- expect: error Unknown

--- case: a size retention keeps the newest messages that fit, removed by the commit that appends
DEFINE TOPIC recent RETAIN BYTES 120;
CREATE recent:1 = { body: 'aaaaaaaaaaaaaaaaaaaa' };
CREATE recent:2 = { body: 'aaaaaaaaaaaaaaaaaaaa' };
CREATE recent:3 = { body: 'aaaaaaaaaaaaaaaaaaaa' };
CREATE recent:4 = { body: 'aaaaaaaaaaaaaaaaaaaa' };
CREATE recent:5 = { body: 'aaaaaaaaaaaaaaaaaaaa' };
CREATE recent:6 = { body: 'aaaaaaaaaaaaaaaaaaaa' };
SELECT * FROM recent:1;
--- expect: rows 0

--- case: and the newest is kept
SELECT * FROM recent:6;
--- expect: rows 1

--- case: a message larger than the size retention is refused
DEFINE TOPIC tiny RETAIN BYTES 8;
CREATE tiny:1 = { body: 'far more than eight bytes' };
--- expect: error TopicMessageTooLarge

--- case: a commit whose own messages outgrow it is refused
BEGIN;
CREATE recent:7 = { body: 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' };
CREATE recent:8 = { body: 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' };
CREATE recent:9 = { body: 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' };
COMMIT;
--- expect: error TopicRetainExceeded

--- case: a deduplicating topic appends a key once inside its window (ADR-0124 D8)
DEFINE TOPIC payments DEDUPLICATE 5m ON payment_id;
CREATE payments = { payment_id: 'p1', amount: 10 };
CREATE payments = { payment_id: 'p1', amount: 10 };
INSERT INTO payments (payment_id, amount) VALUES ('p1', 10), ('p2', 20);
CREATE payments = { amount: 30 };
READ FROM payments;
--- expect: rows 3

--- case: and refuses a key no identity can hold
CREATE payments = { payment_id: 1.5 };
--- expect: error DeduplicationKey

--- case: a topic that deduplicates names the field it reads the key from
DEFINE TOPIC unkeyed DEDUPLICATE 5m;
--- expect: error UnexpectedToken
