# The key-value model: a space is a table whose records hold a single value.

--- case: the tenancy this file works in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
DEFINE SPACE sessions;
--- expect: ok

--- case: a key holds a whole value
SET sessions:'abc' = 42;
GET sessions:'abc';
--- expect: value 42

--- case: a write replaces and never merges
SET sessions:'abc' = { user: 1, live: true };
SET sessions:'abc' = 'replaced';
GET sessions:'abc';
--- expect: value 'replaced'

--- case: a key that holds nothing and a key that is not there are different answers
SET sessions:'here' = NULL;
GET sessions:'here';
--- expect: value NULL

--- case: and the one that is not there
GET sessions:'gone';
--- expect: value NONE

--- case: a key is removed
DEL sessions:'abc';
GET sessions:'abc';
--- expect: value NONE

--- case: the keys of a space
SET sessions:'a' = 1;
SET sessions:'f' = 2;
SET sessions:'m' = 3;
SET sessions:'z' = 4;
KEYS FROM sessions;
--- expect: keys 5

--- case: a range bounds the keys, excluding its end
# 'here' is written earlier in this file and sorts between 'f' and 'm', which is
# the point: text keys order lexicographically, so a range means what the byte
# order says and not what the eye expects.
KEYS FROM sessions RANGE 'a'..'m';
--- expect: keys 3

--- case: and includes it when it says so
KEYS FROM sessions RANGE 'a'..='m';
--- expect: keys 4

--- case: a key-value read stands where a value stands
DEFINE COLLECTION users;
DEFINE INDEX by_email ON users FIELDS email UNIQUE;
CREATE users:1 = { name: 'ada', email: 'ada@example.com' };
DEFINE SPACE emails;
SET emails:'primary' = 'ada@example.com';
SELECT * FROM users WHERE email = GET emails:'primary';
--- expect: rows 1

--- case: an embedded read of one record answers with that record's own value
DEFINE COLLECTION audit;
CREATE audit:1 = {
  actor:  GET emails:'primary',
  target: (SELECT * FROM users:1),
};
SELECT * FROM audit:1;
--- expect: rows 1

--- case: a range bound has to be something a key could be
KEYS FROM sessions RANGE 1.5..2.5;
--- expect: error InvalidKeyBound

# ---- a space as a cache (G035): expiry, atomic writes, a key walk ----

--- case: a key can expire, and TTL says how long it has left
DEFINE SPACE cache;
SET cache:'brief' = 1 EXPIRE 1h;
RETURN TTL cache:'brief' > 59m;
--- expect: value true

--- case: a key that never expires has a NULL TTL
SET cache:'forever' = 1;
RETURN TTL cache:'forever';
--- expect: value NULL

--- case: and a key that is not there has none at all
RETURN TTL cache:'nothing';
--- expect: value NONE

--- case: a plain SET clears the expiry a key had
SET cache:'brief' = 2;
RETURN TTL cache:'brief';
--- expect: value NULL

--- case: EXPIRE gives a key an expiry and says the key was there
EXPIRE cache:'forever' 10m;
--- expect: value true

--- case: and says so when it was not
EXPIRE cache:'nothing' 10m;
--- expect: value false

--- case: PERSIST clears an expiry and says there was one
PERSIST cache:'forever';
--- expect: value true

--- case: an EXPIRE already past removes the key
EXPIRE cache:'forever' -1s;
GET cache:'forever';
--- expect: value NONE

--- case: a SET whose expiry is not in the future is refused
SET cache:'x' = 1 EXPIRE 0s;
--- expect: error InvalidExpiry

--- case: INCR counts from zero and answers the new number
INCR cache:'hits';
INCR cache:'hits' BY 4;
--- expect: value 5

--- case: INCR refuses what is not a number
SET cache:'word' = 'x';
INCR cache:'word';
--- expect: error NotArithmetic

--- case: SET IF ABSENT writes the first time
SET cache:'lock' = 'me' IF ABSENT EXPIRE 30s;
--- expect: value true

--- case: and not the second
SET cache:'lock' = 'you' IF ABSENT;
--- expect: value false

--- case: SET IF = is a compare-and-set
SET cache:'lock' = 'you' IF = 'me';
GET cache:'lock';
--- expect: value 'you'

--- case: SET IF PRESENT never creates a key
SET cache:'ghost' = 1 IF PRESENT;
--- expect: value false

--- case: a prefix lists the keys that begin with it
DEFINE SPACE walk;
SET walk:'user:1:a' = 1;
SET walk:'user:1:b' = 1;
SET walk:'user:10' = 1;
SET walk:'user:2:a' = 1;
KEYS FROM walk PREFIX 'user:1:';
--- expect: keys 2

--- case: a walk pages with AFTER and LIMIT
KEYS FROM walk AFTER 'user:1:a' LIMIT 2;
--- expect: keys 2
