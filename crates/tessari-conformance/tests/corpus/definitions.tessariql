# Definition statements: the catalog, reached only through the language.
# A corpus file is one session against one store, so these run in order.

--- case: a namespace and a database are defined and selected
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
--- expect: ok

--- case: a table is defined
DEFINE TABLE users;
--- expect: ok

--- case: a space is defined
DEFINE SPACE sessions;
--- expect: ok

--- case: an index is defined over one field
DEFINE INDEX by_email ON users FIELDS email UNIQUE;
--- expect: ok

--- case: an index is defined over several fields, and is not unique
DEFINE INDEX by_name ON users FIELDS last, first;
--- expect: ok

--- case: a name is unique within its parent
DEFINE TABLE users;
--- expect: error NameTaken

--- case: if not exists accepts a definition that already stands
DEFINE TABLE IF NOT EXISTS users;
DEFINE INDEX IF NOT EXISTS by_email ON users FIELDS email UNIQUE;
--- expect: ok

--- case: an index is rebuilt from the rows its table holds
# What a rebuild is for is a vector index, whose recall decays as records churn
# because the edges *into* a removed node are left where they are. It is spelled
# as a statement rather than done on the store's own reckoning: two replicas that
# each rebuilt when they felt like it would answer the same approximate question
# differently, and would differ in silence.
CREATE users:1 = { last: 'lovelace', first: 'ada' };
REBUILD INDEX by_name ON users;
--- expect: ok

--- case: and the answer is the one it was before, because that is what an index promises
SELECT * FROM users WHERE last = 'lovelace';
--- expect: rows 1

--- case: rebuilding something nobody defined names what is missing
REBUILD INDEX by_nothing ON users;
--- expect: error Unknown

--- case: an index is removed
DROP INDEX by_name ON users;
--- expect: ok

--- case: a table is removed, and its name is free again
DROP TABLE users;
DEFINE TABLE users;
--- expect: ok

--- case: a definition in another database is reached by qualifying it
DEFINE DATABASE archive;
USE DATABASE archive;
DEFINE TABLE users;
CREATE users:1 = { name: 'grace' };
USE DATABASE orders;
SELECT * FROM archive.users;
--- expect: rows 1

--- case: a field is declared with a type
DEFINE FIELD email ON users TYPE string;
--- expect: ok

--- case: a type name may be a reserved word, because after TYPE nothing else can appear
DEFINE FIELD seen_at ON users TYPE datetime;
DEFINE FIELD owner ON users TYPE record;
DEFINE FIELD tags ON users TYPE set;
--- expect: ok

--- case: a field name is unique within its table
DEFINE FIELD email ON users TYPE string;
--- expect: error NameTaken

--- case: IF NOT EXISTS makes the re-declaration a no-op
DEFINE FIELD IF NOT EXISTS email ON users TYPE string;
--- expect: ok

--- case: a declaration is dropped without touching the data
DROP FIELD seen_at ON users;
--- expect: ok

--- case: a table may be declared schemafull
DEFINE TABLE accounts SCHEMAFULL;
DEFINE FIELD balance ON accounts TYPE decimal;
--- expect: ok

--- case: a field may be required
DEFINE TABLE ledgers;
DEFINE FIELD holder ON ledgers TYPE string REQUIRED;
--- expect: ok

--- case: and a record leaving it out is refused
CREATE ledgers:1 = { balance: dec 0.00 };
--- expect: error MissingRequiredField

--- case: null is not a value for this purpose
CREATE ledgers:2 = { holder: NULL };
--- expect: error MissingRequiredField

--- case: a record holding one is accepted
CREATE ledgers:3 = { holder: 'ada' };
--- expect: ok

--- case: a field may fill itself in
DEFINE FIELD opened ON ledgers TYPE datetime DEFAULT time::now();
--- expect: ok

--- case: and a write leaving it out gets one
CREATE ledgers:4 = { holder: 'grace' };
--- expect: ok

--- case: a default is checked against the type its field declares
DEFINE FIELD tier ON ledgers TYPE int DEFAULT 'gold';
--- expect: error DefaultDoesNotMatch

--- case: requiring a field over rows that lack it writes nothing
DEFINE FIELD nickname ON ledgers TYPE string REQUIRED;
--- expect: error MissingRequiredField

# `ASSERT` — what a value must satisfy beyond its type. Checked by the store on
# its apply path, so what the catalog holds is the lowered constraint rather than
# the sentence that described it, and a replica reaches the same verdict from the
# record alone.

--- case: a field may demand more than a type
DEFINE FIELD balance ON ledgers TYPE int ASSERT $value >= 0;
--- expect: ok

--- case: a value it refuses does not land
CREATE ledgers:10 = { holder: 'ada', balance: -1 };
--- expect: error AssertionViolation

--- case: and one it accepts does
CREATE ledgers:11 = { holder: 'ada', balance: 5 };
--- expect: ok

--- case: an absent value is not a violation, the way an absent type is not
CREATE ledgers:12 = { holder: 'grace' };
--- expect: ok

--- case: a range is two comparisons
DEFINE FIELD age ON ledgers TYPE int ASSERT $value > 0 AND $value < 150;
--- expect: ok

--- case: a set of permitted values is one membership
DEFINE FIELD tier ON ledgers TYPE string ASSERT $value IN ['bronze', 'gold'];
--- expect: ok

--- case: a call is not checkable where validation lives
DEFINE FIELD seen ON ledgers TYPE datetime ASSERT $value < time::now();
--- expect: error AssertionNotAConstraint

--- case: nor any parameter but the value being checked
DEFINE FIELD cap ON ledgers TYPE int ASSERT $limit > 3;
--- expect: error AssertionNotAConstraint

# Another field of the **same record** is inside the vocabulary, because the
# record is already in hand: the route is data the store resolves, not an
# expression it evaluates, so the verdict stays a pure function of the record and
# the catalog and a replica reaches it without reading anything.

--- case: a comparison may name another field of the same record
DEFINE FIELD low ON ledgers TYPE int ASSERT $value < high;
--- expect: ok

--- case: and a route may reach into a nested value
DEFINE FIELD ends_at ON ledgers TYPE int ASSERT $value > window.opens;
--- expect: ok

--- case: a route composes with AND
DEFINE FIELD mid ON ledgers TYPE int ASSERT $value > floor AND $value < ceiling;
--- expect: ok

--- case: with OR
DEFINE FIELD outer ON ledgers TYPE int ASSERT $value < floor OR $value > ceiling;
--- expect: ok

--- case: and under NOT
DEFINE FIELD above ON ledgers TYPE int ASSERT NOT ($value < floor);
--- expect: ok

--- case: but a route reaching several values has no single value to compare
DEFINE FIELD each ON ledgers TYPE int ASSERT $value > slots[*].opens;
--- expect: error AssertionNotAConstraint

--- case: a record the comparison accepts lands
CREATE ledgers:20 = { holder: 'ada', low: 1, high: 5 };
--- expect: ok

--- case: one it refuses does not
CREATE ledgers:21 = { holder: 'ada', low: 9, high: 5 };
--- expect: error AssertionViolation

--- case: and neither does one whose compared field is absent, the way an ordered comparison against a non-value is false anywhere else
CREATE ledgers:22 = { holder: 'ada', low: 1 };
--- expect: error AssertionViolation

# `INFO FOR` — what the catalog holds, read from the catalog itself. Five
# subjects, because each one has exactly one rule deciding what the caller may
# see, and a statement whose answer mixes two permission levels can only give a
# partial answer or a confusing refusal.

--- case: the store lists its namespaces
INFO FOR STORE;
--- expect: ok

--- case: a namespace lists its databases
INFO FOR NAMESPACE;
--- expect: ok

--- case: a database lists its tables
INFO FOR DATABASE;
--- expect: ok

--- case: a table reports its shape, its fields and its indexes
INFO FOR TABLE users;
--- expect: ok

--- case: a table that does not exist is unknown, the way it is everywhere else
INFO FOR TABLE nothing;
--- expect: error Unknown

--- case: only these five subjects, and a sixth names them
INFO FOR INDEX by_email;
--- expect: error UnexpectedToken

--- case: FOR is not optional, because INFO alone asks nothing
INFO STORE;
--- expect: error UnexpectedToken

--- case: FOR is contextual, so it is still a perfectly good field name
CREATE users:'for-test' = { for: 'reserved words are expensive' };
--- expect: ok

--- case: a field's type may be a union of string literals
# `TYPE string` is true about a status column and says nothing. An ASSERT says
# the right thing in the wrong place — a reader of the schema does not see it,
# and a reader of the refusal gets a condition instead of a list.
DEFINE TABLE articles;
DEFINE FIELD status ON articles TYPE 'draft' | 'published' | 'archived';
--- expect: ok

--- case: a member of the union is accepted
CREATE articles:1 = { status: 'draft' };
--- expect: ok

--- case: text the union does not name is refused
CREATE articles:2 = { status: 'deleted' };
--- expect: error SchemaViolation

--- case: and so is a value that is not text at all
CREATE articles:3 = { status: 3 };
--- expect: error SchemaViolation

--- case: the declared type reads back out of the schema report
INFO FOR TABLE articles;
--- expect: ok

--- case: a union is a set, so declaring one twice in another order is one type
DEFINE FIELD status ON articles TYPE 'published' | 'archived' | 'draft';
--- expect: error NameTaken

--- case: a default outside the union is refused when the field is declared
DEFINE FIELD stage ON articles TYPE 'open' | 'closed' DEFAULT 'gone';
--- expect: error DefaultDoesNotMatch

--- case: a default inside it is not
DEFINE FIELD stage ON articles TYPE 'open' | 'closed' DEFAULT 'open';
--- expect: ok

--- case: a union of one member is a type that holds exactly one string
DEFINE FIELD kind ON articles TYPE 'article';
--- expect: ok

--- case: the bar is a union separator and not a boolean or
SELECT * FROM articles WHERE status = 'draft' | status = 'published';
--- expect: error UnexpectedToken
