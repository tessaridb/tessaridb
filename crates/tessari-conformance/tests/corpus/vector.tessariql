# The vector engine: nearest neighbours, and the one place an index is allowed
# to change an answer.
#
# Every other index in this store may change what a read *costs* and never what
# it *answers*. A vector index is the exception, because a graph returns the
# neighbours a walk found and cannot show it missed none — so the exception is
# written into the statement with `APPROXIMATE` rather than left implicit. A read
# that does not say the word gets the exact scan.

--- case: the tenancy this file works in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE atlas;
USE DATABASE atlas;
DEFINE COLLECTION points;
--- expect: ok

--- case: four points in a plane
CREATE points:1 = { at: [0.0, 0.0], name: 'origin' };
CREATE points:2 = { at: [0.1, 0.0], name: 'near' };
CREATE points:3 = { at: [0.9, 0.9], name: 'far' };
CREATE points:4 = { at: [1.0, 1.0], name: 'furthest' };
--- expect: ok

--- case: a distance is an ordinary function, so it sorts like any other
SELECT * FROM points ORDER BY vector::euclidean(at, [0.0, 0.0]) LIMIT 2;
--- expect: rows 2

--- case: the three distances the engine knows
SELECT vector::euclidean(at, [0.0, 0.0]) AS d FROM points:1;
--- expect: rows 1

--- case: cosine
SELECT vector::cosine(at, [1.0, 1.0]) AS d FROM points:3;
--- expect: rows 1

--- case: dot
SELECT vector::dot(at, [1.0, 1.0]) AS d FROM points:4;
--- expect: rows 1

--- case: a graph is declared with the distance it is built for
DEFINE INDEX by_at ON points FIELDS at VECTOR euclidean;
--- expect: ok

--- case: an exact read is still exact once a graph exists
SELECT * FROM points ORDER BY vector::euclidean(at, [0.0, 0.0]) LIMIT 2;
--- expect: rows 2

--- case: and the same read may be served approximately when it says so
SELECT * FROM points ORDER BY vector::euclidean(at, [0.0, 0.0]) LIMIT 2 APPROXIMATE;
--- expect: rows 2

--- case: asking approximately of a distance the graph was not built for is exact
SELECT * FROM points ORDER BY vector::cosine(at, [0.0, 1.0]) LIMIT 2 APPROXIMATE;
--- expect: rows 2

--- case: a distance the engine does not have is refused by name
SELECT * FROM points ORDER BY vector::manhattan(at, [0.0, 0.0]) LIMIT 1;
--- expect: error NoSuchFunction

--- case: a graph declared for a distance the engine does not have is refused
DEFINE INDEX by_wrong ON points FIELDS at VECTOR manhattan;
--- expect: error NoSuchDistance

# A width, declared on the field the vector lives in.
#
# Before this, nothing said how wide a vector was, so a 512-wide row sat legally
# beside a 768-wide one and only the distance function ever noticed — per read,
# long after the write, and not as an error: a vector of the wrong shape is
# infinitely far from everything, which is a plausible ordering.

--- case: a field declares how many components its vectors hold
DEFINE COLLECTION embeddings;
DEFINE FIELD at ON embeddings TYPE vector<3>;
--- expect: ok

--- case: that width is accepted
CREATE embeddings:1 = { at: [1.0, 2.0, 3.0] };
--- expect: ok

--- case: a narrower vector is refused at the write, not at the read
CREATE embeddings:2 = { at: [1.0, 2.0] };
--- expect: error SchemaViolation

--- case: and a wider one
CREATE embeddings:3 = { at: [1.0, 2.0, 3.0, 4.0] };
--- expect: error SchemaViolation

--- case: an array that is not numbers is not a vector of any width
CREATE embeddings:4 = { at: ['a', 'b', 'c'] };
--- expect: error SchemaViolation

--- case: a declared width does not make the field mandatory
CREATE embeddings:5 = { note: 'no vector here' };
--- expect: ok

--- case: the column list of a table says the same thing
DEFINE TABLE documents (title string, at vector<3>);
--- expect: ok

--- case: and refuses the same write
CREATE documents:1 = { title: 'short', at: [1.0, 2.0] };
--- expect: error SchemaViolation

--- case: two vectors of different widths on one table, each held to its own
DEFINE TABLE pages (title_at vector<2>, body_at vector<4>);
CREATE pages:1 = { title_at: [1.0, 2.0], body_at: [1.0, 2.0, 3.0, 4.0] };
--- expect: ok

--- case: the wider value in the narrower field is refused
CREATE pages:2 = { title_at: [1.0, 2.0, 3.0, 4.0] };
--- expect: error SchemaViolation

--- case: a vector holds at least one component
DEFINE FIELD nothing ON embeddings TYPE vector<0>;
--- expect: error VectorWidthBelowOne

--- case: and the width is written out rather than computed
DEFINE FIELD parameterised ON embeddings TYPE vector<$width>;
--- expect: error UnexpectedToken

--- case: a width-less vector is not a type; an array whose length nobody declared is an array
DEFINE FIELD loose ON embeddings TYPE vector;
--- expect: error UnexpectedToken

--- case: and `vector` is still a name a caller may use
DEFINE FIELD vector ON embeddings TYPE vector<4>;
--- expect: ok

# --------------------------------------------------------------------------
# A store of its own. Above this line a vector is a field on a table somebody
# else declared; below it, the word declares the store, its width, its index
# and the fact that the three belong together.

--- case: a vector store declares its width and its distance
DEFINE VECTOR notes DIMENSION 3 DISTANCE cosine;
--- expect: ok

--- case: records go into it and come back out
CREATE notes:'a' = { vector: [1.0, 0.0, 0.0], label: 'a' };
CREATE notes:'b' = { vector: [0.0, 1.0, 0.0], label: 'b' };
SELECT * FROM notes;
--- expect: rows 2

--- case: it is searched with the ordinary distance function, like any other vector
SELECT * FROM notes ORDER BY vector::cosine(vector, [1.0, 0.0, 0.0]) LIMIT 1;
--- expect: rows 1

--- case: a write of the wrong width is refused where it happens
CREATE notes:'c' = { vector: [1.0, 0.0] };
--- expect: error SchemaViolation

--- case: and a record with no vector is not a record of a vector store
CREATE notes:'d' = { label: 'no vector here' };
--- expect: error MissingRequiredField

--- case: the store reports its width, its distance and that nobody has measured it
INFO FOR VECTOR notes;
--- expect: ok

--- case: both clauses are required, in the order they are written
DEFINE VECTOR loose DIMENSION 3;
--- expect: error UnexpectedToken

--- case: a distance has no default, because one would decide which reads the store can serve
DEFINE VECTOR loose DISTANCE cosine;
--- expect: error UnexpectedToken

--- case: a distance this store does not have is refused by name
DEFINE VECTOR loose DIMENSION 3 DISTANCE manhattan;
--- expect: error NoSuchDistance

--- case: a store's width answers to the same rule a field's does
DEFINE VECTOR loose DIMENSION 0 DISTANCE cosine;
--- expect: error VectorWidthBelowOne

--- case: and to the same ceiling
DEFINE VECTOR loose DIMENSION 70000 DISTANCE cosine;
--- expect: error VectorWidthAboveTheCeiling

--- case: a field is held to that ceiling too, because one reader answers for both
DEFINE FIELD wide ON embeddings TYPE vector<70000>;
--- expect: error VectorWidthAboveTheCeiling

--- case: dropping needs the word to name a vector store
DROP VECTOR points;
--- expect: error Unknown

--- case: and the store goes with its field and its index, so the name is free again
DROP VECTOR notes;
DEFINE VECTOR notes DIMENSION 8 DISTANCE euclidean;
--- expect: ok

--- case: a declared store's default read is exact
DEFINE VECTOR readings DIMENSION 2 DISTANCE euclidean;
CREATE readings:1 = { vector: [0.0, 0.0] };
CREATE readings:2 = { vector: [1.0, 0.0] };
CREATE readings:3 = { vector: [5.0, 0.0] };
SELECT * FROM readings ORDER BY vector::euclidean(vector, [0.0, 0.0]) LIMIT 2;
--- expect: rows 2

--- case: and the word is what reaches the graph
SELECT * FROM readings ORDER BY vector::euclidean(vector, [0.0, 0.0]) LIMIT 2 APPROXIMATE;
--- expect: rows 2

--- case: a distance the store was not built for gets the exact answer even with the word
SELECT * FROM readings ORDER BY vector::cosine(vector, [1.0, 0.0]) LIMIT 2 APPROXIMATE;
--- expect: rows 2
