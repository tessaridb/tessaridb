# Configuration: the node in the language, not in a file beside it.
#
# There is no configuration file and no environment variable for what a node is
# for or which peers it has. Both are statements, and they write to two
# different places on purpose (ADR-0018, ADR-0020): what describes THIS machine
# goes to the local `META` keyspace, which the log does not carry, and what
# describes the TOPOLOGY is a catalog record, which it does.
#
# A corpus file is one session against one store, so these run in order.

--- case: a node reports itself before anything is configured
INFO FOR NODE;
--- expect: ok

--- case: roles and endpoints are set by statement
DEFINE NODE ROLES serving, writable ENDPOINTS 'here:9000';
--- expect: ok

--- case: either clause stands on its own
DEFINE NODE ROLES serving, writable;
--- expect: ok

--- case: a statement that sets nothing is refused
DEFINE NODE;
--- expect: error UnexpectedToken

--- case: a role the store does not know is refused rather than stored
DEFINE NODE ROLES leader;
--- expect: error Unknown

--- case: a peer is declared by name and address
DEFINE REPLICA second AT 'there:9001';
--- expect: ok

--- case: a peer's name is what makes it one peer
DEFINE REPLICA second AT 'elsewhere:9001';
--- expect: error NameTaken

--- case: a re-run may say the declaration already stands
DEFINE REPLICA IF NOT EXISTS second AT 'there:9001';
--- expect: ok

--- case: both halves are read back by one statement
INFO FOR NODE;
--- expect: ok

--- case: node is a contextual word, so it is still a table name
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
DEFINE COLLECTION node;
CREATE node:1 = { name: 'ada' };
SELECT * FROM node;
--- expect: ok

--- case: a peer may be declared with the roles that say where writes go
DEFINE REPLICA writer AT 'leader:9001' ROLES serving, writable;
--- expect: ok

--- case: dropping writable is how a node is drained, and it stays readable
DEFINE NODE ROLES serving;
--- expect: ok

--- case: a drained node refuses a write rather than taking it
CREATE node:2 = { name: 'grace' };
--- expect: error NotWritable

--- case: it still answers reads
SELECT * FROM node;
--- expect: ok

--- case: and the statement that gives the role back is not itself a write
DEFINE NODE ROLES serving, writable;
--- expect: ok

--- case: so the node takes writes again
CREATE node:2 = { name: 'grace' };
--- expect: ok

# -------------------------------------------------- NAMESPACE REPLICATION

# How many copies of a namespace the cluster keeps is declared where the
# namespace is declared (ADR-0060), and it can be turned on after the fact
# (D12). The clause is **optional today and mandatory at the release that
# ships the cluster** — a sequencing decision recorded in W211's plan, not a
# reversal: with no nodes to place copies on, a mandatory clause could only be
# answered `NONE`, which trains an operator to decline without thinking and is
# the inherited default the decision exists to abolish.
#
# What is bought now is the one thing that cannot be added later: a namespace
# that said nothing and a namespace that said `NONE` stay different values.

--- case: a namespace may declare how many copies it wants
DEFINE NAMESPACE replicated REPLICATION FACTOR 3;
--- expect: ok

--- case: or decline replication, which is a statement and not a silence
DEFINE NAMESPACE declined REPLICATION NONE;
--- expect: ok

--- case: a bare definition still works and states nothing
DEFINE NAMESPACE unsaid;
--- expect: ok

--- case: replication is turned on for a namespace that already exists
ALTER NAMESPACE unsaid REPLICATION FACTOR 2;
--- expect: ok

--- case: and turned off again, because a policy you cannot withdraw is one you hesitate to set
ALTER NAMESPACE unsaid REPLICATION NONE;
--- expect: ok

--- case: a namespace reads its own policy back
USE NAMESPACE replicated;
INFO FOR NAMESPACE;
--- expect: ok

--- case: no copies at all is not a policy and is refused where it is written
ALTER NAMESPACE unsaid REPLICATION FACTOR 0;
--- expect: error UnexpectedToken

--- case: the statement carries only what it came to change, so it must name it
ALTER NAMESPACE unsaid;
--- expect: error UnexpectedToken

--- case: altering a namespace nobody declared is refused rather than creating one
ALTER NAMESPACE ghost REPLICATION FACTOR 2;
--- expect: error Unknown
