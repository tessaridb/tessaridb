# The time-series engine: a time-keyed table, a window, and a retention policy.
#
# Two shapes are exercised here, and the first is still the general one. A time
# series is an ordinary table with an indexed instant, so every read, every
# index and every statement the language already has works on it — and the two
# things it genuinely could not say were a **window** and a **retention
# policy**. The cases below the tenancy exercise that table.
#
# The second shape is `DEFINE SERIES … RETAIN`, a table kind that declares how
# far back its answer reaches. It exists because a retention *policy* written as
# a statement is something an operator has to remember to run, while a declared
# floor is a property of the table that every read applies. Its identity is
# fixed to UUID v7, which is what makes an age floor a position in the key
# rather than a predicate over a field. The cases from `fleeting` onward
# exercise that kind.
#
# This header used to say there was no such kind and that its absence was the
# design. That was true when it was written and stopped being true when the kind
# shipped; it is corrected rather than deleted, because the first paragraph is
# still the answer for a table that wants no floor.

--- case: the tenancy this file works in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE metrics;
USE DATABASE metrics;
DEFINE COLLECTION readings;
DEFINE INDEX by_at ON readings FIELDS at;
--- expect: ok

--- case: six readings across three hours, with a gap
CREATE readings:1 = { at: datetime '2026-03-01T00:05:00Z', level: 1 };
CREATE readings:2 = { at: datetime '2026-03-01T00:35:00Z', level: 2 };
CREATE readings:3 = { at: datetime '2026-03-01T00:59:59Z', level: 3 };
CREATE readings:4 = { at: datetime '2026-03-01T01:00:00Z', level: 4 };
CREATE readings:5 = { at: datetime '2026-03-01T01:30:00Z', level: 5 };
CREATE readings:6 = { at: datetime '2026-03-01T03:10:00Z', level: 6 };
--- expect: ok

--- case: a range over an indexed instant is a bounded read, not a walk
SELECT * FROM readings
WHERE at >= datetime '2026-03-01T01:00:00Z' AND at < datetime '2026-03-01T02:00:00Z';
--- expect: rows 2

--- case: counting per hour — three windows of different sizes, and a gap
SELECT count(*) AS held, time::bucket(at, 1h) AS window
FROM readings GROUP BY time::bucket(at, 1h);
--- expect: rows 3

--- case: a window with no readings has no row, rather than a row nobody wrote
SELECT count(*) AS held FROM readings
WHERE at >= datetime '2026-03-01T02:00:00Z' AND at < datetime '2026-03-01T03:00:00Z'
GROUP BY time::bucket(at, 1h);
--- expect: rows 0

--- case: windows are anchored at the epoch, so every process agrees on them
SELECT time::bucket(datetime '2026-03-01T00:59:59Z', 1h) AS w FROM readings:1;
--- expect: rows 1

--- case: a window of nothing is refused rather than divided by
SELECT time::bucket(at, 0s) AS w FROM readings:1;
--- expect: error CallFailed

--- case: a sub-second window is refused rather than rounded
SELECT time::bucket(at, 500ms) AS w FROM readings:1;
--- expect: error CallFailed

--- case: an aggregate over the whole series needs no window at all
SELECT count(*) AS held, max(level) AS peak FROM readings;
--- expect: rows 1

--- case: over an ordinary table a retention policy is a statement
DELETE FROM readings WHERE at < datetime '2026-03-01T01:00:00Z' LIMIT ALL;
--- expect: ok

--- case: and it says how many it removed
SELECT count(*) AS held FROM readings;
--- expect: rows 1

--- case: what the policy kept is exactly what it was asked to keep
SELECT * FROM readings;
--- expect: rows 3

--- case: a series declares a floor, and the word that made it is what INFO writes back
DEFINE SERIES fleeting RETAIN 1h;
--- expect: ok

--- case: a record written now is inside the floor
CREATE fleeting = { level: 3 };
--- expect: ok

--- case: and the table answers with it
SELECT * FROM fleeting;
--- expect: rows 1

--- case: a record named at an instant in 2024 is written without complaint
CREATE fleeting:uuid '018cc251-f400-7abc-8d11-223344556677' = { level: 4 };
--- expect: ok

--- case: the table does not answer with it, because it is past the floor
SELECT * FROM fleeting;
--- expect: rows 1

--- case: and naming it directly does not step around the floor either
SELECT * FROM fleeting:uuid '018cc251-f400-7abc-8d11-223344556677';
--- expect: rows 0

--- case: a retention that could only empty the answer is refused where it is written
DEFINE SERIES empty RETAIN 0s;
--- expect: error EmptyRetention

--- case: dropping a series that is a plain table is refused
DEFINE TABLE ordinary SCHEMALESS;
DROP SERIES ordinary;
--- expect: error Unknown

--- case: and the series itself drops
DROP SERIES fleeting;
--- expect: ok

--- case: a series ordered by its event time takes a rollup
DEFINE SERIES gauges RETAIN 36500d TIME at;
DEFINE ROLLUP per_hour FROM gauges WINDOW 1h BY sensor COMPUTE count(*) AS n, sum(v) AS total RETAIN 36500d;
--- expect: ok

--- case: a late reading is folded into the window it belongs to
CREATE gauges = { sensor: 'a', v: 2, at: datetime '2026-09-29T10:10:00Z' };
CREATE gauges = { sensor: 'a', v: 3, at: datetime '2026-09-29T10:50:00Z' };
CREATE gauges = { sensor: 'a', v: 5, at: datetime '2026-09-29T09:59:00Z' };
SELECT * FROM per_hour;
--- expect: rows 2

--- case: a rollup keeps only what merges exactly from its row
DEFINE ROLLUP averages FROM gauges WINDOW 1h COMPUTE mean(v) AS avg RETAIN 1d;
--- expect: error RollupFold

--- case: a rollup is written by its series and not by hand
CREATE per_hour = { window: datetime '2026-09-29T10:00:00Z', n: 1 };
--- expect: error RollupIsDerived

--- case: the series cannot go while a rollup is kept of it, and the rollup can
DROP SERIES gauges;
--- expect: error RollupsDependOn

--- case: dropping the rollup first lets the series go
DROP ROLLUP per_hour;
DROP SERIES gauges;
--- expect: ok
