# The vault: a store whose fields are sealed before anything else sees them.
#
# `DEFINE VAULT team` is the sixth word that declares a whole engine, and unlike
# the other five it is not a desugaring. There is no spelling of `DEFINE TABLE`
# plus clauses that produces one, because what makes a vault a vault is a **key**
# — minted when the vault is declared, wrapped under the store's master key, and
# carried on the declaration itself.
#
# That is why it is the one declaration that requires an unsealed store. A vault
# created with its key left for later would refuse every write while `INFO`
# reported it ready.
#
# # Where the encryption happens, and why it decides what these cases can assert
#
# The sealed envelope **is** the stored payload value: sealing happens before the
# record is encoded, not on the way out of a session. So a `SELECT` over a vault
# that reached the records would answer with opaque bytes rather than plaintext,
# and every path below the session — the search index, the change feed, the
# replication log, a backup file — carries ciphertext without having to know what
# a vault is.
#
# This makes the four refusals below two different kinds of thing, and a reader
# deciding to relax one needs to know which is which:
#
#   - `DEFINE INDEX` over a secret field is a **control**. An index is a
#     searchable copy of the plaintext: the term dictionary holds the analysed
#     value and the postings say which records share it, so a caller who may not
#     read the field could still ask, one term at a time, whether any record
#     holds a given value.
#
#   - `SELECT` over a vault protects nothing, because what it would return is
#     already ciphertext. It is refused so the language means something: opaque
#     bytes teach a caller that the vault is broken, while a refusal naming
#     `REVEAL` teaches them the feature.
#
# The filter and the ordering the specification lists separately are subsumed by
# the second: there is no `SELECT` shape over a vault for either to hang off, and
# `REVEAL` has nowhere to put one by construction.
#
# # The field here is called `token` and not `password`
#
# `PASSWORD` is a reserved word, so `DEFINE FIELD password ON team …` does not
# parse while `{ password: '…' }` in a record does. A vault is the one place
# somebody will certainly try the first spelling. That asymmetry is a real defect
# and is recorded rather than worked around silently.

--- case: the tenancy this file works in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE work;
USE DATABASE work;
--- expect: ok

--- case: a vault cannot be declared while the store is sealed
DEFINE VAULT team;
--- expect: error Vault

--- case: the first unseal creates the store's root
UNSEAL VAULT WITH 'an operator passphrase';
--- expect: ok

--- case: and then one word declares the store
DEFINE VAULT team;
--- expect: ok

--- case: its fields are declared one at a time, and one of them is sealed
DEFINE FIELD login ON team TYPE string;
DEFINE FIELD token ON team TYPE string SECRET;
--- expect: ok

--- case: SECRET needs a vault, because nothing else has a key to honour it with
DEFINE TABLE staff SCHEMALESS;
DEFINE FIELD token ON staff TYPE string SECRET;
--- expect: error SecretNeedsVault

--- case: a vault holds ordinary records, written the ordinary way
CREATE team:'github' = { login: 'boog', token: 'hunter2' };
--- expect: ok

--- case: SELECT over a vault is refused, and the message names the word that reads one
SELECT * FROM team;
--- expect: error NotReadBySelect

--- case: a filter over a vault is refused for being a read of one
SELECT * FROM team WHERE token = 'hunter2';
--- expect: error NotReadBySelect

--- case: an ordering over a vault is refused for the same reason
SELECT * FROM team ORDER BY token;
--- expect: error NotReadBySelect

--- case: and so is naming the record directly
SELECT * FROM team:'github';
--- expect: error NotReadBySelect

--- case: an index over a secret field would be a searchable copy of it
DEFINE INDEX by_token ON team FIELDS token;
--- expect: error NotIndexable

--- case: a projection of a secret is a secret somebody derived
DEFINE INDEX by_part ON team FIELDS token.inner;
--- expect: error NotIndexable

--- case: an index over a field that is not sealed is fine
DEFINE INDEX by_login ON team FIELDS login;
--- expect: ok

--- case: REVEAL is the one path to a plaintext
REVEAL token FROM team:'github';
--- expect: ok

--- case: and a star opens every sealed field
REVEAL * FROM team:'github';
--- expect: ok

--- case: a field that was never sealed is refused rather than answered in the clear
REVEAL login FROM team:'github';
--- expect: error NotASecret

--- case: INFO reports the vault with the word that created it
INFO FOR VAULT team;
--- expect: ok

--- case: sealing takes the key out of this process
SEAL VAULT;
--- expect: ok

--- case: after which nothing opens, for anybody
REVEAL token FROM team:'github';
--- expect: error Vault

--- case: and a write to a sealed vault is refused rather than written in the clear
CREATE team:'second' = { token: 'hunter2' };
--- expect: error Vault

--- case: a wrong passphrase does not unseal
UNSEAL VAULT WITH 'not the passphrase';
--- expect: error Vault

--- case: the right one does, and the store opens again
UNSEAL VAULT WITH 'an operator passphrase';
--- expect: ok

--- case: dropping the vault destroys the key, which is the deletion
DROP VAULT team;
--- expect: ok

--- case: and the name is gone with it
INFO FOR VAULT team;
--- expect: error Unknown
