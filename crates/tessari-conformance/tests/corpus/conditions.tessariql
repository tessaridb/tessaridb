# Conditions: a filter is an expression that answers with a boolean.
# A corpus file is one session against one store, so these run in order.

--- case: a namespace and a database, to work in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
--- expect: ok

--- case: a table holding several types in one field, and two absences
DEFINE TABLE people;
CREATE people:1 = { name: 'ada', age: 17, city: 'Paris', tags: ['urgent'] };
CREATE people:2 = { name: 'grace', age: 45, city: 'Lyon', tags: ['old'] };
CREATE people:3 = { name: 'alan', age: 'nineteen', city: 'Paris' };
CREATE people:4 = { name: 'edsger', age: NULL, city: 'Lyon' };
CREATE people:5 = { name: 'barbara', city: 'Paris' };
--- expect: ok

--- case: equality is exact on the whole value
SELECT * FROM people WHERE city = 'Paris';
--- expect: rows 3

--- case: inequality is its complement
SELECT * FROM people WHERE city != 'Paris';
--- expect: rows 2

--- case: an ordered comparison follows the declared order, across types
SELECT * FROM people WHERE age > 18;
--- expect: rows 2

--- case: none and null are not small values
SELECT * FROM people WHERE age < 1000;
--- expect: rows 2

--- case: the absent field is found by the literal that names it
SELECT * FROM people WHERE age = NONE;
--- expect: rows 1

--- case: and the null one by the other literal
SELECT * FROM people WHERE age = NULL;
--- expect: rows 1

--- case: conjunction narrows
SELECT * FROM people WHERE city = 'Paris' AND age = 17;
--- expect: rows 1

--- case: AND binds tighter than OR
SELECT * FROM people WHERE city = 'Paris' AND age = 17 OR name = 'grace';
--- expect: rows 2

--- case: and parentheses say the other thing
SELECT * FROM people WHERE city = 'Paris' AND (age = 17 OR name = 'grace');
--- expect: rows 1

--- case: negation, with no third truth value
SELECT * FROM people WHERE NOT (age = 17);
--- expect: rows 4

--- case: membership from the collection's end
SELECT * FROM people WHERE tags CONTAINS 'urgent';
--- expect: rows 1

--- case: and from the value's end
SELECT * FROM people WHERE 'urgent' IN tags;
--- expect: rows 1

--- case: a pattern covers the whole value
SELECT * FROM people WHERE name LIKE 'ad%';
--- expect: rows 1

--- case: an index narrows one conjunct and the rest still applies
DEFINE INDEX by_city ON people FIELDS city;
--- expect: ok

--- case: the indexed conjunction answers what the scan answered
SELECT * FROM people WHERE city = 'Paris' AND age = 17;
--- expect: rows 1

--- case: a bare name in a value position is still a table
DEFINE TABLE audit;
CREATE audit:1 = { subject: people };
--- expect: ok

--- case: a condition that is not a boolean is refused
SELECT * FROM people WHERE name;
--- expect: error ConditionNotBoolean

--- case: two comparisons in a row are refused
SELECT * FROM people WHERE 1 < age < 100;
--- expect: error UnexpectedToken

--- case: a read may say what order it wants
SELECT * FROM people ORDER BY name;
--- expect: rows 5

--- case: several keys, and a reversed one
SELECT * FROM people ORDER BY city, name DESC;
--- expect: rows 5

--- case: a bound takes a window after the order
SELECT * FROM people ORDER BY name START 1 LIMIT 2;
--- expect: rows 2

--- case: a start past the end is a state rather than a mistake
SELECT * FROM people ORDER BY name START 99;
--- expect: rows 0

--- case: a bound with no order still applies
SELECT * FROM people LIMIT 1;
--- expect: rows 1

--- case: a bounded descending order is taken from an index that holds it
# Three of the five carry an age, so the index holds three entries. The order
# itself is asserted in the session suite, which can see it; what this pins is
# that the statement answers the same count either way.
DEFINE INDEX by_age ON people FIELDS age;
SELECT * FROM people ORDER BY age DESC LIMIT 2;
--- expect: rows 2

--- case: and a bound the index cannot fill is still answered, by the scan
# `people:5` has no age at all, so it has no entry — and descending it belongs
# after every record that does.
SELECT * FROM people ORDER BY age DESC LIMIT 5;
--- expect: rows 5

--- case: the words that shape a read are not reserved names
DEFINE TABLE order;
CREATE order:1 = { limit: 10, by: 'ada', start: 1 };
SELECT * FROM order ORDER BY by LIMIT 1;
--- expect: rows 1

--- case: a fold answers once for many records
SELECT count(*) AS n FROM people;
--- expect: rows 1

--- case: counting a value and counting records are different questions
SELECT count(*) AS records, count(age) AS ages FROM people;
--- expect: rows 1

--- case: grouping answers once per distinct key
SELECT city, count(*) AS n FROM people GROUP BY city;
--- expect: rows 2

--- case: the folds pass over what holds nothing
DEFINE TABLE scores;
CREATE scores:1 = { n: 10 };
CREATE scores:2 = { n: 20 };
CREATE scores:3 = { n: NULL };
CREATE scores:4 = { other: 'no n at all' };
SELECT sum(n) AS total, mean(n) AS average, count(n) AS held FROM scores;
--- expect: rows 1

--- case: a fold over something that is not a number fails
SELECT sum(name) AS total FROM people;
--- expect: error NotSummable

--- case: a grouped read may answer only with its keys and its folds
SELECT name, count(*) AS n FROM people GROUP BY city;
--- expect: error UngroupedProjection

--- case: a star means the records themselves, which only count can fold
SELECT sum(*) AS n FROM people;
--- expect: error StarIsOnlyForCount

# Composing over a fold. A fold is an expression, so everything an expression can
# be part of, a fold can be part of — and its value is constant within its group,
# which the evaluator makes literally true by substituting it before the rest of
# the expression runs.

--- case: arithmetic over a fold
SELECT sum(n) * 2 AS doubled FROM scores;
--- expect: rows 1

--- case: two folds in one expression are two folds
SELECT sum(n) / count(*) AS per_score FROM scores;
--- expect: rows 1

--- case: a fold composed with a group key, per group
SELECT city, count(*) * 10 AS scaled FROM people GROUP BY city;
--- expect: rows 2

--- case: a fold folding over a fold has nothing left to fold
SELECT mean(sum(n)) AS nonsense FROM scores;
--- expect: error FoldInsideAFold

--- case: a filter sees one record at a time, so a fold there is a filter over groups
SELECT city FROM people WHERE count(*) > 1 GROUP BY city;
--- expect: error FoldInAFilter

--- case: and an ordering is per record too
SELECT city, count(*) AS n FROM people GROUP BY city ORDER BY count(*);
--- expect: error FoldInAFilter

--- case: ordering and bounding a grouped read shapes the groups
SELECT city, count(*) AS n FROM people GROUP BY city ORDER BY n DESC LIMIT 1;
--- expect: rows 1

--- case: a field called count is still a field
DEFINE TABLE tallies;
CREATE tallies:1 = { count: 7 };
SELECT * FROM tallies WHERE count = 7;
--- expect: rows 1

# `EXPLAIN` — the plan a read would take, without taking it. A decision nobody
# can look at is a decision nobody can debug.

--- case: a read no index serves explains as a scan
EXPLAIN SELECT * FROM people WHERE age > 1;
--- expect: ok

--- case: and one an index serves names it
EXPLAIN SELECT * FROM people WHERE city = 'Paris';
--- expect: ok

--- case: only a read has a plan to describe
EXPLAIN DELETE people:1;
--- expect: error UnexpectedToken
