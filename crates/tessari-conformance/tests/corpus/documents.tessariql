# Documents: a record payload is a tree, and a path is how something inside it
# is named. Nothing here is a new storage feature — `Value::Object` and
# `Value::Array` have always nested. What is new is being able to say where.
# A corpus file is one session against one store, so these run in order.

--- case: a namespace and a database, to work in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
--- expect: ok

--- case: records whose shapes differ, which is the point of holding documents
DEFINE COLLECTION people;
CREATE people:1 = { name: 'ada', address: { city: 'Paris', zip: '75001' }, tags: ['urgent', 'old'] };
CREATE people:2 = { name: 'grace', address: { city: 'Lyon' }, tags: ['old'] };
CREATE people:3 = { name: 'alan', address: 'Paris' };
CREATE people:4 = { name: 'edsger' };
--- expect: ok

--- case: a route reaches a value nested one level down
SELECT * FROM people WHERE address.city = 'Paris';
--- expect: rows 1

--- case: a route reaches an element of an array by its position
SELECT * FROM people WHERE tags[0] = 'urgent';
--- expect: rows 1

--- case: a position is a position and not a membership test
SELECT * FROM people WHERE tags[1] = 'old';
--- expect: rows 1

--- case: a route with no such root reaches nothing
SELECT * FROM people WHERE postcode = 'x';
--- expect: rows 0

--- case: a route through a value that is not an object reaches nothing
SELECT * FROM people WHERE address.city.first = 'x';
--- expect: rows 0

--- case: an object addressed by position reaches nothing
SELECT * FROM people WHERE address[0] = 'x';
--- expect: rows 0

--- case: a position past the end reaches nothing
SELECT * FROM people WHERE tags[9] = 'old';
--- expect: rows 0

--- case: a route may be indexed, and the index is built over the rows already there
DEFINE INDEX by_home_city ON people FIELDS address.city;
--- expect: ok

--- case: the indexed route answers the same records it answered by scan
SELECT * FROM people WHERE address.city = 'Paris';
--- expect: rows 1

--- case: a prefix pattern on a route is a range over the same index
SELECT * FROM people WHERE address.city LIKE 'Par%';
--- expect: rows 1

--- case: an index on a route is not an index on what the route starts from
SELECT * FROM people WHERE address = 'Paris';
--- expect: rows 1

--- case: a composite index may mix a route and a plain field
DEFINE INDEX by_city_and_name ON people FIELDS address.city, name;
--- expect: ok

--- case: a route is not read where a table may stand
SELECT * FROM orders.people;
--- expect: rows 4

--- case: a position is a whole number
SELECT * FROM people WHERE tags[-1] = 'old';
--- expect: error UnexpectedToken

--- case: a read may ask for some of a record rather than all of it
SELECT name FROM people;
--- expect: rows 4

--- case: a projected route answers under the last step of its name
SELECT address.city FROM people;
--- expect: rows 4

--- case: AS names a projection, and a position needs one
SELECT address.city AS home, tags[0] AS first_tag FROM people:1;
--- expect: rows 1

--- case: a position with no name is refused
SELECT tags[0] FROM people;
--- expect: error UnnamedProjection

--- case: two projections answering under one name are refused
SELECT address.city, work.city FROM people;
--- expect: error DuplicateProjection

--- case: a projection does not change the access path
SELECT name FROM people WHERE address.city = 'Paris';
--- expect: rows 1

# `[*]` — every element rather than one of them. A route holding it denotes the
# values it reaches rather than a value, and two contexts have a rule for several
# so far: a comparison, which holds when any of them satisfies it, and a
# projection, which answers with all of them.

--- case: a comparison over every element holds when any element does
SELECT * FROM people WHERE tags[*] = 'urgent';
--- expect: rows 1

--- case: and finds the records the other element belongs to
SELECT * FROM people WHERE tags[*] = 'old';
--- expect: rows 2

--- case: no element matching is no match, not a failure
SELECT * FROM people WHERE tags[*] = 'nothing like this';
--- expect: rows 0

--- case: negating any of them means none of them
SELECT * FROM people WHERE NOT tags[*] = 'urgent';
--- expect: rows 3

--- case: a projection over several answers with all of them
SELECT tags[*] AS all_tags FROM people;
--- expect: rows 4

--- case: and every record answers, because zero of them is an empty array
SELECT tags[*] AS all_tags FROM people:4;
--- expect: rows 1

--- case: it stands as the whole projected value and not inside a larger one
SELECT array::len(tags[*]) AS n FROM people;
--- expect: error SeveralOutsideAComparison

--- case: a multi-valued projection still has to be named
SELECT tags[*] FROM people;
--- expect: error UnnamedProjection

--- case: an ordering over several has no rule either
SELECT * FROM people ORDER BY tags[*];
--- expect: error SeveralOutsideAComparison

# A multikey index: one entry per element rather than one per record, which is
# what lets an index serve a question about elements without answering it with
# an answer about arrays.

--- case: an index over several is a multikey index
DEFINE INDEX by_tag ON people FIELDS tags[*];
--- expect: ok

--- case: and it answers what the scan answered
SELECT * FROM people WHERE tags[*] = 'old';
--- expect: rows 2

--- case: including for the element only one record holds
SELECT * FROM people WHERE tags[*] = 'urgent';
--- expect: rows 1

--- case: a value no element holds finds nothing rather than failing
SELECT * FROM people WHERE tags[*] = 'nothing like this';
--- expect: rows 0

--- case: a UNIQUE multikey index has two readings and is refused
DEFINE INDEX by_tag_unique ON people FIELDS tags[*] UNIQUE;
--- expect: error SeveralInAUniqueIndex

--- case: a search index decides its own multiplicity
DEFINE INDEX by_tag_search ON people FIELDS tags[*] SEARCH;
--- expect: error SeveralInAnAnalysedIndex

--- case: and one index holds one multi-valued route
DEFINE INDEX by_two ON people FIELDS tags[*], aliases[*];
--- expect: error SeveralRoutesInOneIndex
