# Full-text search: the analyzer belongs to the field, so an index can make the
# question fast without being able to change its answer.
# A corpus file is one session against one store, so these run in order.

--- case: a namespace and a database, to work in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
--- expect: ok

--- case: an analyzer is declared once and attached where it is needed
DEFINE ANALYZER simple FILTERS lowercase, ascii;
--- expect: ok

--- case: a name is unique, like every other name
DEFINE ANALYZER simple FILTERS lowercase;
--- expect: error NameTaken

--- case: and IF NOT EXISTS says so out loud
DEFINE ANALYZER IF NOT EXISTS simple FILTERS lowercase;
--- expect: ok

--- case: a filter this language does not have is refused
DEFINE ANALYZER stemmed FILTERS porter;
--- expect: error UnexpectedToken

--- case: an analyzer attaches to a field, not to an index
DEFINE TABLE notes SCHEMALESS;
DEFINE FIELD body ON notes TYPE string ANALYZER simple;
--- expect: ok

--- case: records to search
CREATE notes:1 = { body: 'Ada Lovelace wrote the first program', title: 'Ada' };
CREATE notes:2 = { body: 'A note about the café on the corner' };
CREATE notes:3 = { body: 'lovelacex is not the same word' };
CREATE notes:4 = { title: 'no body at all' };
--- expect: ok

--- case: a term is a whole word, which is what makes this not a pattern
SELECT * FROM notes WHERE body MATCHES 'lovelace';
--- expect: rows 1

--- case: the filters are what make two spellings one term
SELECT * FROM notes WHERE body MATCHES 'cafe';
--- expect: rows 1

--- case: several terms mean all of them
SELECT * FROM notes WHERE body MATCHES 'ada program';
--- expect: rows 1

--- case: and a term the text does not hold finds nothing
SELECT * FROM notes WHERE body MATCHES 'ada babbage';
--- expect: rows 0

--- case: a field with no analyzer holds no terms
SELECT * FROM notes WHERE title MATCHES 'ada';
--- expect: rows 0

--- case: a search composes with everything else a condition can say
SELECT * FROM notes WHERE body MATCHES 'lovelace' AND title = 'Ada';
--- expect: rows 1

--- case: an index over the same field changes the cost and not the answer
DEFINE INDEX by_body ON notes FIELDS body SEARCH;
--- expect: ok

--- case: the indexed search answers what the scan answered
SELECT * FROM notes WHERE body MATCHES 'lovelace';
--- expect: rows 1

--- case: several terms are the postings of each, intersected
SELECT * FROM notes WHERE body MATCHES 'ada program';
--- expect: rows 1

--- case: the filters still apply, because they are the field's and not the index's
SELECT * FROM notes WHERE body MATCHES 'CAFE';
--- expect: rows 1

--- case: an update takes back the postings the record no longer earns
UPDATE notes:1 = { body: 'Grace Hopper wrote a compiler', title: 'Ada' };
SELECT * FROM notes WHERE body MATCHES 'lovelace';
--- expect: rows 0

--- case: and leaves the ones it now does
SELECT * FROM notes WHERE body MATCHES 'hopper';
--- expect: rows 1

# Ranking. A score is not a property of a document — it measures one against the
# collection — so it needs statistics the index maintains, and is refused where
# there are none rather than answered with a number that orders nothing at all.

--- case: another note, so there is a collection to rank within
CREATE notes:9 = { body: 'hopper hopper hopper and nothing else', title: 'Grace' };
--- expect: ok

--- case: a score is an ordinary expression, addressable in a projection
SELECT search::score(body, 'hopper') AS relevance FROM notes;
--- expect: rows 5

--- case: and in an ORDER BY, which is all a ranked read is
SELECT * FROM notes ORDER BY search::score(body, 'hopper') DESC LIMIT 1;
--- expect: rows 1

--- case: a record holding none of the query's words scores zero, not nothing
SELECT * FROM notes WHERE search::score(body, 'unheardof') > 0;
--- expect: rows 0

--- case: a score with the wrong number of arguments is refused before anything runs
SELECT search::score(body) AS relevance FROM notes;
--- expect: error WrongArity

--- case: a score over a field with no search index is refused, naming the field
SELECT search::score(title, 'ada') AS relevance FROM notes;
--- expect: error NoSearchIndex

--- case: and a single record is not a collection either
SELECT search::score(body, 'hopper') AS relevance FROM notes:9;
--- expect: error NoSearchIndex

# The vector index. Every other index in this store changes what a read costs and
# not what it answers; this one cannot, so the statement has to ask.

--- case: a table of vectors to search
DEFINE COLLECTION points;
CREATE points:1 = { at: [0.0, 0.0] };
CREATE points:2 = { at: [1.0, 0.0] };
CREATE points:3 = { at: [5.0, 0.0] };
--- expect: ok

--- case: a vector index declares the distance its graph is built for
DEFINE INDEX by_at ON points FIELDS at VECTOR euclidean;
--- expect: ok

--- case: a distance the store does not have is refused where it is written
DEFINE INDEX by_at2 ON points FIELDS at VECTOR manhattan;
--- expect: error NoSuchDistance

--- case: one index kind and not two
DEFINE INDEX by_at3 ON points FIELDS at SEARCH VECTOR cosine;
--- expect: error UnexpectedToken

--- case: without the word the read is the exact scan it always was
SELECT * FROM points ORDER BY vector::euclidean(at, [0.1, 0.0]) LIMIT 2;
--- expect: rows 2

--- case: with the word, the graph may serve it
SELECT * FROM points ORDER BY vector::euclidean(at, [0.1, 0.0]) LIMIT 2 APPROXIMATE;
--- expect: rows 2

--- case: asking approximately of a field with no index is still exact
SELECT * FROM points ORDER BY vector::cosine(at, [0.1, 0.9]) LIMIT 2 APPROXIMATE;
--- expect: rows 2

--- case: approximate is contextual, so a field may be called it
CREATE points:4 = { approximate: true, vector: 'a field called vector' };
SELECT approximate FROM points:4;
--- expect: rows 1
