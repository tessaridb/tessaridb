# Full-text search: the analyzer belongs to the field, so an index can make the
# question fast without being able to change its answer.
# A corpus file is one session against one store, so these run in order.

--- case: a namespace and a database, to work in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
--- expect: ok

--- case: an analyzer is declared once and attached where it is needed
DEFINE ANALYZER simple FILTERS lowercase, ascii;
--- expect: ok

--- case: a name is unique, like every other name
DEFINE ANALYZER simple FILTERS lowercase;
--- expect: error NameTaken

--- case: and IF NOT EXISTS says so out loud
DEFINE ANALYZER IF NOT EXISTS simple FILTERS lowercase;
--- expect: ok

--- case: a filter this language does not have is refused
DEFINE ANALYZER stemmed FILTERS porter;
--- expect: error UnexpectedToken

--- case: an analyzer attaches to a field, not to an index
DEFINE TABLE notes SCHEMALESS;
DEFINE FIELD body ON notes TYPE string ANALYZER simple;
--- expect: ok

--- case: records to search
CREATE notes:1 = { body: 'Ada Lovelace wrote the first program', title: 'Ada' };
CREATE notes:2 = { body: 'A note about the café on the corner' };
CREATE notes:3 = { body: 'lovelacex is not the same word' };
CREATE notes:4 = { title: 'no body at all' };
--- expect: ok

--- case: a term is a whole word, which is what makes this not a pattern
SELECT * FROM notes WHERE body MATCHES 'lovelace';
--- expect: rows 1

--- case: the filters are what make two spellings one term
SELECT * FROM notes WHERE body MATCHES 'cafe';
--- expect: rows 1

--- case: several terms mean all of them
SELECT * FROM notes WHERE body MATCHES 'ada program';
--- expect: rows 1

--- case: and a term the text does not hold finds nothing
SELECT * FROM notes WHERE body MATCHES 'ada babbage';
--- expect: rows 0

--- case: a field with no analyzer holds no terms
SELECT * FROM notes WHERE title MATCHES 'ada';
--- expect: rows 0

--- case: a search composes with everything else a condition can say
SELECT * FROM notes WHERE body MATCHES 'lovelace' AND title = 'Ada';
--- expect: rows 1

--- case: an index over the same field changes the cost and not the answer
DEFINE INDEX by_body ON notes FIELDS body SEARCH;
--- expect: ok

--- case: the indexed search answers what the scan answered
SELECT * FROM notes WHERE body MATCHES 'lovelace';
--- expect: rows 1

--- case: several terms are the postings of each, intersected
SELECT * FROM notes WHERE body MATCHES 'ada program';
--- expect: rows 1

--- case: the filters still apply, because they are the field's and not the index's
SELECT * FROM notes WHERE body MATCHES 'CAFE';
--- expect: rows 1

# `MATCHES PREFIX` — the words a reader has started typing. Every case is run
# here with the index in place; the scan's agreement with it is asserted per
# record by the session suite, which can hold two stores at once.

--- case: a table of its own, so these cases cannot move another case's count
DEFINE TABLE typed SCHEMALESS;
DEFINE FIELD body ON typed TYPE string ANALYZER simple;
DEFINE INDEX by_typed ON typed FIELDS body SEARCH;
CREATE typed:1 = { body: 'Vector search over a store', title: 'one' };
CREATE typed:2 = { body: 'Vectors and their distances' };
CREATE typed:3 = { body: 'A vectorised inner loop' };
CREATE typed:4 = { body: 'Locking and contention' };
--- expect: ok

--- case: a prefix reaches every word that begins with it
SELECT * FROM typed WHERE body MATCHES PREFIX 'vecto';
--- expect: rows 3

--- case: it is still a conjunction across the words that were typed
SELECT * FROM typed WHERE body MATCHES PREFIX 'vecto sea';
--- expect: rows 1

--- case: a word nothing begins with empties the conjunction
SELECT * FROM typed WHERE body MATCHES PREFIX 'vecto zzz';
--- expect: rows 0

--- case: a complete word is a prefix of itself
SELECT * FROM typed WHERE body MATCHES PREFIX 'vectorised';
--- expect: rows 1

--- case: below the minimum it is refused rather than answered slowly
SELECT * FROM typed WHERE body MATCHES PREFIX 've';
--- expect: error PrefixTooShort

--- case: and at the minimum it is served
SELECT * FROM typed WHERE body MATCHES PREFIX 'vec';
--- expect: rows 3

--- case: a field with no analyzer holds no terms to begin with either
SELECT * FROM typed WHERE title MATCHES PREFIX 'one';
--- expect: rows 0

--- case: an update takes back the postings the record no longer earns
UPDATE notes:1 = { body: 'Grace Hopper wrote a compiler', title: 'Ada' };
SELECT * FROM notes WHERE body MATCHES 'lovelace';
--- expect: rows 0

--- case: and leaves the ones it now does
SELECT * FROM notes WHERE body MATCHES 'hopper';
--- expect: rows 1

# Ranking. A score is not a property of a document — it measures one against the
# collection — so it needs statistics the index maintains, and is refused where
# there are none rather than answered with a number that orders nothing at all.

--- case: another note, so there is a collection to rank within
CREATE notes:9 = { body: 'hopper hopper hopper and nothing else', title: 'Grace' };
--- expect: ok

--- case: a score is an ordinary expression, addressable in a projection
SELECT search::score(body, 'hopper') AS relevance FROM notes;
--- expect: rows 5

--- case: and in an ORDER BY, which is all a ranked read is
SELECT * FROM notes ORDER BY search::score(body, 'hopper') DESC LIMIT 1;
--- expect: rows 1

--- case: a record holding none of the query's words scores zero, not nothing
SELECT * FROM notes WHERE search::score(body, 'unheardof') > 0;
--- expect: rows 0

--- case: a score with the wrong number of arguments is refused before anything runs
SELECT search::score(body) AS relevance FROM notes;
--- expect: error WrongArity

--- case: a score over a field with no search index is refused, naming the field
SELECT search::score(title, 'ada') AS relevance FROM notes;
--- expect: error NoSearchIndex

--- case: and a single record is not a collection either
SELECT search::score(body, 'hopper') AS relevance FROM notes:9;
--- expect: error NoSearchIndex

# The vector index. Every other index in this store changes what a read costs and
# not what it answers; this one cannot, so the statement has to ask.

--- case: a table of vectors to search
DEFINE COLLECTION points;
CREATE points:1 = { at: [0.0, 0.0] };
CREATE points:2 = { at: [1.0, 0.0] };
CREATE points:3 = { at: [5.0, 0.0] };
--- expect: ok

--- case: a vector index declares the distance its graph is built for
DEFINE INDEX by_at ON points FIELDS at VECTOR euclidean;
--- expect: ok

--- case: a distance the store does not have is refused where it is written
DEFINE INDEX by_at2 ON points FIELDS at VECTOR manhattan;
--- expect: error NoSuchDistance

--- case: one index kind and not two
DEFINE INDEX by_at3 ON points FIELDS at SEARCH VECTOR cosine;
--- expect: error UnexpectedToken

--- case: without the word the read is the exact scan it always was
SELECT * FROM points ORDER BY vector::euclidean(at, [0.1, 0.0]) LIMIT 2;
--- expect: rows 2

--- case: with the word, the graph may serve it
SELECT * FROM points ORDER BY vector::euclidean(at, [0.1, 0.0]) LIMIT 2 APPROXIMATE;
--- expect: rows 2

--- case: asking approximately of a field with no index is still exact
SELECT * FROM points ORDER BY vector::cosine(at, [0.1, 0.9]) LIMIT 2 APPROXIMATE;
--- expect: rows 2

--- case: approximate is contextual, so a field may be called it
CREATE points:4 = { approximate: true, vector: 'a field called vector' };
SELECT approximate FROM points:4;
--- expect: rows 1

# `MATCHES FUZZY` — the word a reader meant rather than the one they typed. As
# above, these run with the index in place; the scan's agreement with it is
# asserted per record by the session suite, which can hold two stores at once.

--- case: a table of its own, so these cases cannot move another case's count
DEFINE TABLE mistyped SCHEMALESS;
DEFINE FIELD body ON mistyped TYPE string ANALYZER simple;
DEFINE INDEX by_mistyped ON mistyped FIELDS body SEARCH;
CREATE mistyped:1 = { body: 'Vector search over a store' };
CREATE mistyped:2 = { body: 'A container for the analyzer' };
CREATE mistyped:3 = { body: 'Locking and contention' };
CREATE mistyped:4 = { body: 'The doctor and the victor' };
--- expect: ok

--- case: a dropped letter still finds the word it was dropped from
SELECT * FROM mistyped WHERE body MATCHES FUZZY 'vectr';
--- expect: rows 1

--- case: a word spelled correctly still matches itself
SELECT * FROM mistyped WHERE body MATCHES FUZZY 'vector';
--- expect: rows 1

--- case: it is still a conjunction across the words that were typed
SELECT * FROM mistyped WHERE body MATCHES FUZZY 'containr analyzr';
--- expect: rows 1

--- case: a word nothing comes near empties the conjunction
SELECT * FROM mistyped WHERE body MATCHES FUZZY 'containr zzzqqq';
--- expect: rows 0

--- case: a mistake inside the first three characters is not found
SELECT * FROM mistyped WHERE body MATCHES FUZZY 'xector';
--- expect: rows 0

--- case: too short to carry a non-fuzzy prefix, so it is refused
SELECT * FROM mistyped WHERE body MATCHES FUZZY 've';
--- expect: error PrefixTooShort

--- case: a transposition costs two edits and is still inside the budget
SELECT * FROM mistyped WHERE body MATCHES FUZZY 'vectro';
--- expect: rows 1

--- case: but a transposition inside the first three characters is not found
SELECT * FROM mistyped WHERE body MATCHES FUZZY 'vetcor';
--- expect: rows 0

--- case: a collection holding the same two words in both orders
DEFINE COLLECTION phrased;
DEFINE FIELD body ON phrased TYPE string ANALYZER simple;
CREATE phrased:1 = { body: 'ada lovelace wrote the first program' };
CREATE phrased:2 = { body: 'lovelace ada, reversed on purpose' };
CREATE phrased:3 = { body: 'ada alone without the surname' };
--- expect: ok

--- case: unquoted is a conjunction, so word order does not matter
SELECT * FROM phrased WHERE body MATCHES 'ada lovelace';
--- expect: rows 2

--- case: quoted is a phrase, so word order is the whole question
SELECT * FROM phrased WHERE body MATCHES '"ada lovelace"';
--- expect: rows 1

--- case: and the reversed phrase finds the reversed record
SELECT * FROM phrased WHERE body MATCHES '"lovelace ada"';
--- expect: rows 1

--- case: a phrase of one word is that word
SELECT * FROM phrased WHERE body MATCHES '"ada"';
--- expect: rows 3

--- case: slop zero is contiguity, and one word sits between these two
SELECT * FROM phrased WHERE body MATCHES '"ada wrote"~0';
--- expect: rows 0

--- case: one token of slop absorbs exactly one token
SELECT * FROM phrased WHERE body MATCHES '"ada wrote"~1';
--- expect: rows 1

--- case: slop widens the window and never relaxes the order
SELECT * FROM phrased WHERE body MATCHES '"wrote ada"~9';
--- expect: rows 0

--- case: an explicit zero is the bare phrase
SELECT * FROM phrased WHERE body MATCHES '"ada lovelace"~0';
--- expect: rows 1

--- case: one quote is not a phrase, so it is the words it holds
SELECT * FROM phrased WHERE body MATCHES '"ada lovelace';
--- expect: rows 2

--- case: a slop marker that is not a number is refused by name
SELECT * FROM phrased WHERE body MATCHES '"ada lovelace"~x';
--- expect: error MalformedSlop

--- case: a slop marker with no number is the same refusal
SELECT * FROM phrased WHERE body MATCHES '"ada lovelace"~';
--- expect: error MalformedSlop

--- case: a negative slop is refused rather than clamped to zero
SELECT * FROM phrased WHERE body MATCHES '"ada lovelace"~-1';
--- expect: error MalformedSlop

--- case: an index does not change what a phrase means
DEFINE INDEX by_phrased ON phrased FIELDS body SEARCH;
--- expect: ok

--- case: the same phrase, now served from the index
SELECT * FROM phrased WHERE body MATCHES '"ada lovelace"';
--- expect: rows 1

--- case: and the refusal is raised before the index is consulted
SELECT * FROM phrased WHERE body MATCHES '"ada lovelace"~x';
--- expect: error MalformedSlop

--- case: a collection for the boolean forms, with a record only OR reaches
DEFINE COLLECTION boolean;
DEFINE FIELD body ON boolean TYPE string ANALYZER simple;
CREATE boolean:1 = { body: 'ada worked with babbage on the engine' };
CREATE boolean:2 = { body: 'ada wrote the first program' };
CREATE boolean:3 = { body: 'lovelace is the surname' };
CREATE boolean:4 = { body: 'nothing to do with either of them' };
--- expect: ok

--- case: an unquoted query is still the conjunction it always was
SELECT * FROM boolean WHERE body MATCHES 'ada babbage';
--- expect: rows 1

--- case: OR unions the terms, reaching a record the conjunction drops
SELECT * FROM boolean WHERE body MATCHES 'ada OR lovelace';
--- expect: rows 3

--- case: NOT removes a record the required terms reached
SELECT * FROM boolean WHERE body MATCHES 'ada NOT babbage';
--- expect: rows 1

--- case: the three forms compose in one query
SELECT * FROM boolean WHERE body MATCHES 'ada OR lovelace NOT babbage';
--- expect: rows 2

--- case: a lowercase or is a word, so a query written before the operators is unchanged
SELECT * FROM boolean WHERE body MATCHES 'ada or lovelace';
--- expect: rows 0

--- case: excluding without requiring is refused by name
SELECT * FROM boolean WHERE body MATCHES 'NOT babbage';
--- expect: error NegationWithoutTerm

--- case: an index does not change what the boolean forms mean
DEFINE INDEX by_boolean ON boolean FIELDS body SEARCH;
--- expect: ok

--- case: the same disjunction, now served from the index
SELECT * FROM boolean WHERE body MATCHES 'ada OR lovelace';
--- expect: rows 3

--- case: and the same composition
SELECT * FROM boolean WHERE body MATCHES 'ada OR lovelace NOT babbage';
--- expect: rows 2

--- case: and the refusal is raised before the index is consulted
SELECT * FROM boolean WHERE body MATCHES 'NOT babbage';
--- expect: error NegationWithoutTerm

--- case: a collection where one spelling is held and a near one is not
DEFINE COLLECTION spelled;
--- expect: ok

--- case: the field is analyzed so the terms exist
DEFINE FIELD body ON spelled TYPE string ANALYZER simple;
--- expect: ok

--- case: three records hold the word
CREATE spelled:1 = { body: 'the vector index walks a graph' };
--- expect: ok

--- case: a second
CREATE spelled:2 = { body: 'a vector is a list of numbers' };
--- expect: ok

--- case: a third, beside a word the misspelling does not reach
CREATE spelled:3 = { body: 'the engine stores every vector' };
--- expect: ok

--- case: a misspelled term finds nothing, and is not answered as the word it resembles
SELECT * FROM spelled WHERE body MATCHES 'vecter';
--- expect: rows 0

--- case: the spelling that is held finds all three
SELECT * FROM spelled WHERE body MATCHES 'vector';
--- expect: rows 3

--- case: an index is added, which changes what a read costs
DEFINE INDEX by_spelled ON spelled FIELDS body SEARCH;
--- expect: ok

--- case: and the misspelled term still finds nothing, suggestion or no suggestion
SELECT * FROM spelled WHERE body MATCHES 'vecter';
--- expect: rows 0

--- case: while a query mixing a held word and a misspelled one answers on the held one alone
SELECT * FROM spelled WHERE body MATCHES 'engine OR vecter';
--- expect: rows 1
