# `INSERT`: several records at once, at identities the store produces.
#
# This is the batch form of a write the store names. `CREATE` writes one record;
# this writes many, taking the fields once and the values per row. Both ask the
# table for identities under the scheme it was declared with, and the file beside
# this one (`records`) is the evidence that the addressed `CREATE` was left alone.
#
# The cases at the end are here because this file is where the two halves of one
# identity space actually meet: rows the store named, and a record the caller
# named, in the same table.

--- case: the tenancy this file works in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
DEFINE COLLECTION users;
--- expect: ok

--- case: one record, and the store answers with the identity it produced
INSERT INTO users (name, email) VALUES ('ada', 'ada@example.com');
--- expect: keys 1

--- case: several records in one statement, and one identity per row
INSERT INTO users (name, email) VALUES
  ('grace', 'grace@example.com'),
  ('alan', 'alan@example.com'),
  ('edsger', 'edsger@example.com');
--- expect: keys 3

--- case: every one of them is there afterwards
SELECT * FROM users;
--- expect: rows 4

--- case: two rows of one batch never share an identity
SELECT * FROM users WHERE name = 'grace';
--- expect: rows 1

--- case: the produced identity is a real identity, not a placeholder
SELECT * FROM users WHERE email = 'alan@example.com';
--- expect: rows 1

--- case: a row holding fewer values than the field list is refused
INSERT INTO users (name, email) VALUES ('ada');
--- expect: error InsertRowArity

--- case: a row holding more values than the field list is refused
INSERT INTO users (name) VALUES ('ada', 'ada@example.com');
--- expect: error InsertRowArity

--- case: the refusal is at parse, so a bad row writes nothing before it
SELECT * FROM users;
--- expect: rows 4

--- case: a table nobody declared is refused
INSERT INTO nowhere (name) VALUES ('ada');
--- expect: error Unknown

--- case: a value may be computed, because a value position holds an expression
INSERT INTO users (name, email, score) VALUES ('hedy', 'hedy@example.com', 40 + 2);
--- expect: keys 1

--- case: and what was stored is the computed value, not the expression
SELECT * FROM users WHERE score = 42;
--- expect: rows 1

--- case: `CREATE` is untouched — an identity may still be named
CREATE users:900 = { name: 'katherine', email: 'katherine@example.com' };
--- expect: ok

--- case: and naming one that is taken is still refused
CREATE users:900 = { name: 'someone else' };
--- expect: error RecordExists

--- case: naming one the store already produced is refused for the same reason
CREATE users:1 = { name: 'someone else' };
--- expect: error RecordExists

--- case: the caller's name does not move the counter — this is the sixth record
INSERT INTO users (name) VALUES ('barbara');
--- expect: keys 1

--- case: and it landed at 6, not at 901
SELECT * FROM users:6;
--- expect: rows 1

--- case: a generated identity walks past one the caller named
CREATE users:7 = { name: 'named seven' };
--- expect: ok

--- case: so the next produced identity is 8 and not a refusal
INSERT INTO users (name) VALUES ('grete');
--- expect: keys 1

--- case: 7 is still the record the caller wrote there
SELECT * FROM users WHERE name = 'named seven';
--- expect: rows 1

--- case: and 8 is the one the store named
SELECT * FROM users:8;
--- expect: rows 1
