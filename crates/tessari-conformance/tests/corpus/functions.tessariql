# Arithmetic and functions, and the thing that makes either worth having:
# something to compute for.
# A corpus file is one session against one store, so these run in order.

--- case: a namespace and a database, to work in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
--- expect: ok

--- case: rows carrying the three numeric kinds, and one missing a field
DEFINE COLLECTION lines;
CREATE lines:1 = { name: 'ada', price: dec 2.50, quantity: 3, weight: 1.5, tags: ['a', 'b'] };
CREATE lines:2 = { name: 'grace', price: dec 1.00, quantity: 1 };
--- expect: ok

--- case: a computed projection
SELECT price * quantity AS total FROM lines:1;
--- expect: rows 1

--- case: division does not truncate
SELECT quantity / 2 AS half FROM lines:1;
--- expect: rows 1

--- case: a division by zero has no answer
SELECT quantity / 0 AS bad FROM lines:1;
--- expect: error ArithmeticFailed

--- case: arithmetic on something that is not a number has no answer
SELECT name + quantity AS bad FROM lines:1;
--- expect: error NotArithmetic

--- case: a function computes over the record it projects
SELECT string::upper(name) AS shout, string::len(name) AS letters FROM lines:1;
--- expect: rows 1

--- case: the last element, which a path cannot reach
SELECT array::last(tags) AS newest FROM lines:1;
--- expect: rows 1

--- case: an absent argument answers with an absence rather than failing the read
SELECT array::len(tags) AS count FROM lines;
--- expect: rows 2

--- case: and that absence narrows a condition rather than breaking it
SELECT * FROM lines WHERE array::len(tags) > 1;
--- expect: rows 1

--- case: a function composes inside a condition
SELECT * FROM lines WHERE string::len(name) = 3;
--- expect: rows 1

--- case: the type of a value is the one question an absence answers
SELECT type::of(tags) AS kind FROM lines;
--- expect: rows 2

--- case: the wrong number of arguments is refused when the statement is read
SELECT string::len(name, name) AS n FROM lines;
--- expect: error WrongArity

--- case: a function this language does not have is refused by name
SELECT string::nope(name) AS n FROM lines;
--- expect: error NoSuchFunction

--- case: a wrong argument type names the function and the position
SELECT string::len(quantity) AS n FROM lines:1;
--- expect: error WrongArgument

--- case: anything computed needs a name of its own
SELECT string::len(name) FROM lines;
--- expect: error UnnamedProjection

--- case: parentheses group arithmetic as they group conditions
SELECT (quantity + 1) * 2 AS doubled FROM lines:1;
--- expect: rows 1

--- case: a negation of something that is not a literal
SELECT -quantity AS owed FROM lines:1;
--- expect: rows 1

--- case: vectors to search
DEFINE COLLECTION points;
CREATE points:1 = { name: 'east', at: [1.0, 0.0] };
CREATE points:2 = { name: 'north-east', at: [0.7, 0.7] };
CREATE points:3 = { name: 'north', at: [0.0, 1.0] };
CREATE points:4 = { name: 'wrong shape', at: [1.0] };
CREATE points:5 = { name: 'none at all' };
--- expect: ok

--- case: a nearest-neighbour query is an order and a bound
SELECT * FROM points ORDER BY vector::cosine(at, [1.0, 0.0]) LIMIT 2;
--- expect: rows 2

--- case: what has no distance is infinitely far, so it never crowds out a neighbour
SELECT * FROM points ORDER BY vector::cosine(at, [1.0, 0.0]);
--- expect: rows 5

--- case: three distances, because three questions
SELECT vector::cosine(at, [2.0, 0.0]) AS angle, vector::euclidean(at, [2.0, 0.0]) AS gap, vector::dot(at, [2.0, 0.0]) AS inner FROM points:1;
--- expect: rows 1

--- case: ordering by anything computed, which the same widening bought
SELECT * FROM points ORDER BY string::len(name) DESC LIMIT 1;
--- expect: rows 1

--- case: a digest is the published one, which is the only way to know it is SHA-2
# Every property a digest has — its length, its alphabet, that it changes when
# the input does — is satisfied by a hash that is not SHA-256 at all. The
# standard's own vector is the assertion that means something.
RETURN crypto::sha256('abc');
--- expect: value 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'

--- case: and the same for SHA-512
RETURN crypto::sha512('abc');
--- expect: value 'ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f'

--- case: the empty string has a digest, and it is not the empty string
RETURN crypto::sha256('');
--- expect: value 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'

--- case: a digest is text, so it compares with what a caller wrote down
RETURN crypto::sha256('abc') = 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad';
--- expect: value true

--- case: the argument is text and nothing else, because type::string is total
# Strictness is affordable exactly where the language holds the sentence the
# caller should write instead. Hashing "the canonical text of any value" would
# promise that `3`, `3.0` and the decimal `3.0` — one value in this store —
# have one digest, which they could not.
RETURN crypto::sha256(42);
--- expect: error WrongArgument

--- case: and that sentence works
RETURN crypto::sha256(type::string(42)) = crypto::sha256('42');
--- expect: value true

--- case: an absent argument answers NONE, as every one-argument function does
RETURN crypto::sha512(NONE);
--- expect: value NONE

--- case: a digest is pure, so one statement asking twice gets one answer
RETURN crypto::sha256('x') = crypto::sha256('x');
--- expect: value true

--- case: and it is a function of its argument
RETURN crypto::sha256('x') = crypto::sha256('y');
--- expect: value false

--- case: the wrong number of arguments is refused before anything runs
RETURN crypto::sha256('a', 'b');
--- expect: error WrongArity

--- case: a line window returns the run it names
RETURN string::lines('one\ntwo\nthree\nfour', 0, 2) = 'one\ntwo';
--- expect: value true

--- case: and the next window continues it, so two windows rebuild the document
RETURN string::lines('one\ntwo\nthree\nfour', 2, 2) = 'three\nfour';
--- expect: value true

--- case: a count reaching past the end takes what is there
RETURN string::lines('one\ntwo', 1, 10) = 'two';
--- expect: value true

--- case: a start past the end is empty rather than an error
RETURN string::lines('one\ntwo', 9, 1) = '';
--- expect: value true

--- case: a negative start is refused, as it is for both slices
RETURN string::lines('one\ntwo', -1, 1);
--- expect: error CallFailed

--- case: a carriage return does not survive into the window
RETURN string::lines('one\r\ntwo\r\n', 0, 2) = 'one\ntwo';
--- expect: value true

--- case: a trailing newline does not grow a line for the count to spend
RETURN string::lines('one\ntwo\n', 0, 3) = 'one\ntwo';
--- expect: value true

# The checksums, against the vectors their own specifications print. They are
# here beside SHA-2 rather than in a file of their own because what separates
# them is what they may be used for and not how they are called.

--- case: md5 of the canonical three letters
RETURN crypto::md5('abc');
--- expect: value '900150983cd24fb0d6963f7d28e17f72'

--- case: md5 of nothing is still a digest
RETURN crypto::md5('');
--- expect: value 'd41d8cd98f00b204e9800998ecf8427e'

--- case: sha1 of the same three letters
RETURN crypto::sha1('abc');
--- expect: value 'a9993e364706816aba3e25717850c26c9cd0d89d'

--- case: sha1 of nothing
RETURN crypto::sha1('');
--- expect: value 'da39a3ee5e6b4b0d3255bfef95601890afd80709'

--- case: a checksum of an absent field is absent, like every other function
RETURN crypto::md5(NONE);
--- expect: value NONE

# Bytes as text. The vectors are RFC 4648 §10's, which is what makes a
# hand-written codec worth trusting.

--- case: base64 pads a one-byte tail with two equals signs
RETURN encoding::base64(0x66);
--- expect: value 'Zg=='

--- case: base64 of three bytes needs no padding
RETURN encoding::base64(0x666f6f);
--- expect: value 'Zm9v'

--- case: base64 of six bytes
RETURN encoding::base64(0x666f6f626172);
--- expect: value 'Zm9vYmFy'

--- case: and it decodes back to the bytes it came from
RETURN encoding::base64_decode('Zm9vYmFy') = 0x666f6f626172;
--- expect: value true

--- case: text that is not base64 spells no bytes
RETURN encoding::base64_decode('!!!!');
--- expect: value NONE

--- case: a length that is not a multiple of four spells no bytes either
RETURN encoding::base64_decode('abc');
--- expect: value NONE

--- case: padding bits that are not zero would let two strings mean one value
RETURN encoding::base64_decode('Zh==');
--- expect: value NONE

--- case: hex is lowercase
RETURN encoding::hex(0x0abcde);
--- expect: value '0abcde'

--- case: hex reads either case back
RETURN encoding::hex_decode('0ABCDE') = 0x0abcde;
--- expect: value true

--- case: an odd number of hexadecimal characters spells no bytes
RETURN encoding::hex_decode('abc');
--- expect: value NONE

--- case: a character outside the alphabet spells no bytes
RETURN encoding::hex_decode('zz');
--- expect: value NONE

# The string functions a pattern cannot serve, because a needle is a value.

--- case: a prefix that is a value and not a pattern
RETURN string::starts_with('lovelace', 'love');
--- expect: value true

--- case: and one that is not the prefix
RETURN string::starts_with('lovelace', 'ada');
--- expect: value false

--- case: a per-cent sign in the needle is a character and not a wildcard
RETURN string::starts_with('lovelace', '%');
--- expect: value false

--- case: a suffix
RETURN string::ends_with('lovelace', 'lace');
--- expect: value true

--- case: text holding text
RETURN string::contains('lovelace', 'vela');
--- expect: value true

--- case: an underscore in the needle matches an underscore and nothing else
RETURN string::contains('lovelace', '_');
--- expect: value false

--- case: where it first occurs, counted in characters and not in bytes
RETURN string::index_of('naïve', 'v');
--- expect: value 3

--- case: a needle that is not there answers nothing rather than minus one
RETURN string::index_of('lovelace', 'z');
--- expect: value NONE

--- case: the front trimmed and the end left alone
RETURN string::trim_start('  ada  ') = 'ada  ';
--- expect: value true

--- case: and the other way round
RETURN string::trim_end('  ada  ') = '  ada';
--- expect: value true

--- case: characters back to front, which is not the bytes back to front
RETURN string::reverse('naïve');
--- expect: value 'evïan'

# The numbers.

--- case: the smaller of two
RETURN math::min(3, 5);
--- expect: value 3

--- case: the larger of two, keeping the kind it came in as
RETURN math::max(3, 5);
--- expect: value 5

--- case: sign is minus one, zero or one
RETURN math::sign(-4.5);
--- expect: value -1

--- case: and zero has no direction
RETURN math::sign(0);
--- expect: value 0

--- case: trunc goes toward zero where floor goes down
RETURN math::trunc(-2.7) = -2 AND math::floor(-2.7) = -3;
--- expect: value true

--- case: the natural logarithm of one is zero
RETURN math::ln(1) = 0;
--- expect: value true

--- case: and of zero there is none, rather than a negative infinity
RETURN math::ln(0);
--- expect: value NONE

--- case: a negative has no logarithm either
RETURN math::ln(-1);
--- expect: value NONE

--- case: e to the zero
RETURN math::exp(0) = 1;
--- expect: value true

# One array folded inside one record, which the aggregates cannot do.

--- case: the smallest in an array
RETURN array::min([3, 1, 2]);
--- expect: value 1

--- case: the largest
RETURN array::max([3, 1, 2]);
--- expect: value 3

--- case: nothing has no smallest
RETURN array::min([]);
--- expect: value NONE

--- case: the numbers added
RETURN array::sum([1, 2, 3]);
--- expect: value 6

--- case: over nothing, zero — which is what the sum aggregate answers too
RETURN array::sum([]);
--- expect: value 0

--- case: two arrays joined
RETURN array::concat([1, 2], [3]) = [1, 2, 3];
--- expect: value true

--- case: appending an array adds one element and does not splice it
RETURN array::append([1, 2], [3, 4]) = [1, 2, [3, 4]];
--- expect: value true

--- case: where a value first appears
RETURN array::index_of(['a', 'b', 'c'], 'b');
--- expect: value 1

--- case: a value that is not there answers nothing
RETURN array::index_of(['a'], 'z');
--- expect: value NONE

# Objects, taken apart and put back together.

--- case: entries pair each name with its value, in the object's own order
RETURN object::entries({ a: 1, b: 2 }) = [['a', 1], ['b', 2]];
--- expect: value true

--- case: a field that is there
RETURN object::has({ a: 1 }, 'a');
--- expect: value true

--- case: a field explicitly holding nothing is still there
RETURN object::has({ a: NONE }, 'a');
--- expect: value true

--- case: and one that was never named is not
RETURN object::has({ a: 1 }, 'b');
--- expect: value false

--- case: merging, with the second object winning a collision
RETURN object::merge({ a: 1, b: 2 }, { b: 9, c: 3 }) = { a: 1, b: 9, c: 3 };
--- expect: value true
