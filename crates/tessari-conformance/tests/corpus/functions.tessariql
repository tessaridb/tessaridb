# Arithmetic and functions, and the thing that makes either worth having:
# something to compute for.
# A corpus file is one session against one store, so these run in order.

--- case: a namespace and a database, to work in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
--- expect: ok

--- case: rows carrying the three numeric kinds, and one missing a field
DEFINE TABLE lines;
CREATE lines:1 = { name: 'ada', price: dec 2.50, quantity: 3, weight: 1.5, tags: ['a', 'b'] };
CREATE lines:2 = { name: 'grace', price: dec 1.00, quantity: 1 };
--- expect: ok

--- case: a computed projection
SELECT price * quantity AS total FROM lines:1;
--- expect: rows 1

--- case: division does not truncate
SELECT quantity / 2 AS half FROM lines:1;
--- expect: rows 1

--- case: a division by zero has no answer
SELECT quantity / 0 AS bad FROM lines:1;
--- expect: error ArithmeticFailed

--- case: arithmetic on something that is not a number has no answer
SELECT name + quantity AS bad FROM lines:1;
--- expect: error NotArithmetic

--- case: a function computes over the record it projects
SELECT string::upper(name) AS shout, string::len(name) AS letters FROM lines:1;
--- expect: rows 1

--- case: the last element, which a path cannot reach
SELECT array::last(tags) AS newest FROM lines:1;
--- expect: rows 1

--- case: an absent argument answers with an absence rather than failing the read
SELECT array::len(tags) AS count FROM lines;
--- expect: rows 2

--- case: and that absence narrows a condition rather than breaking it
SELECT * FROM lines WHERE array::len(tags) > 1;
--- expect: rows 1

--- case: a function composes inside a condition
SELECT * FROM lines WHERE string::len(name) = 3;
--- expect: rows 1

--- case: the type of a value is the one question an absence answers
SELECT type::of(tags) AS kind FROM lines;
--- expect: rows 2

--- case: the wrong number of arguments is refused when the statement is read
SELECT string::len(name, name) AS n FROM lines;
--- expect: error WrongArity

--- case: a function this language does not have is refused by name
SELECT string::nope(name) AS n FROM lines;
--- expect: error NoSuchFunction

--- case: a wrong argument type names the function and the position
SELECT string::len(quantity) AS n FROM lines:1;
--- expect: error WrongArgument

--- case: anything computed needs a name of its own
SELECT string::len(name) FROM lines;
--- expect: error UnnamedProjection

--- case: parentheses group arithmetic as they group conditions
SELECT (quantity + 1) * 2 AS doubled FROM lines:1;
--- expect: rows 1

--- case: a negation of something that is not a literal
SELECT -quantity AS owed FROM lines:1;
--- expect: rows 1

--- case: vectors to search
DEFINE TABLE points;
CREATE points:1 = { name: 'east', at: [1.0, 0.0] };
CREATE points:2 = { name: 'north-east', at: [0.7, 0.7] };
CREATE points:3 = { name: 'north', at: [0.0, 1.0] };
CREATE points:4 = { name: 'wrong shape', at: [1.0] };
CREATE points:5 = { name: 'none at all' };
--- expect: ok

--- case: a nearest-neighbour query is an order and a bound
SELECT * FROM points ORDER BY vector::cosine(at, [1.0, 0.0]) LIMIT 2;
--- expect: rows 2

--- case: what has no distance is infinitely far, so it never crowds out a neighbour
SELECT * FROM points ORDER BY vector::cosine(at, [1.0, 0.0]);
--- expect: rows 5

--- case: three distances, because three questions
SELECT vector::cosine(at, [2.0, 0.0]) AS angle, vector::euclidean(at, [2.0, 0.0]) AS gap, vector::dot(at, [2.0, 0.0]) AS inner FROM points:1;
--- expect: rows 1

--- case: ordering by anything computed, which the same widening bought
SELECT * FROM points ORDER BY string::len(name) DESC LIMIT 1;
--- expect: rows 1

--- case: a digest is the published one, which is the only way to know it is SHA-2
# Every property a digest has — its length, its alphabet, that it changes when
# the input does — is satisfied by a hash that is not SHA-256 at all. The
# standard's own vector is the assertion that means something.
RETURN crypto::sha256('abc');
--- expect: value 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'

--- case: and the same for SHA-512
RETURN crypto::sha512('abc');
--- expect: value 'ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f'

--- case: the empty string has a digest, and it is not the empty string
RETURN crypto::sha256('');
--- expect: value 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855'

--- case: a digest is text, so it compares with what a caller wrote down
RETURN crypto::sha256('abc') = 'ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad';
--- expect: value true

--- case: the argument is text and nothing else, because type::string is total
# Strictness is affordable exactly where the language holds the sentence the
# caller should write instead. Hashing "the canonical text of any value" would
# promise that `3`, `3.0` and the decimal `3.0` — one value in this store —
# have one digest, which they could not.
RETURN crypto::sha256(42);
--- expect: error WrongArgument

--- case: and that sentence works
RETURN crypto::sha256(type::string(42)) = crypto::sha256('42');
--- expect: value true

--- case: an absent argument answers NONE, as every one-argument function does
RETURN crypto::sha512(NONE);
--- expect: value NONE

--- case: a digest is pure, so one statement asking twice gets one answer
RETURN crypto::sha256('x') = crypto::sha256('x');
--- expect: value true

--- case: and it is a function of its argument
RETURN crypto::sha256('x') = crypto::sha256('y');
--- expect: value false

--- case: the wrong number of arguments is refused before anything runs
RETURN crypto::sha256('a', 'b');
--- expect: error WrongArity
