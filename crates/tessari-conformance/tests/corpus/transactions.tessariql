# Transactions: what lands together, and what does not land at all.

--- case: the tenancy this file works in
DEFINE NAMESPACE prod;
USE NAMESPACE prod;
DEFINE DATABASE orders;
USE DATABASE orders;
--- expect: ok

--- case: a definition and a write land together
BEGIN;
DEFINE COLLECTION users;
CREATE users:1 = { name: 'ada' };
COMMIT;
--- expect: ok

--- case: and they are both there afterwards
SELECT * FROM users;
--- expect: rows 1

--- case: a cancelled transaction leaves nothing behind
BEGIN;
DEFINE COLLECTION accounts;
CREATE accounts:1 = { balance: 10 };
CANCEL;
--- expect: ok

--- case: not even the table it defined
SELECT * FROM accounts;
--- expect: error Unknown

--- case: a script that opens a transaction and never closes it discards and says so
BEGIN;
CREATE users:2 = { name: 'grace' };
--- expect: error UnclosedTransaction

--- case: and the discarded write is not there
SELECT * FROM users;
--- expect: rows 1

--- case: a second BEGIN inside one is refused
BEGIN;
BEGIN;
--- expect: error NestedTransaction

--- case: a COMMIT with nothing open is refused
COMMIT;
--- expect: error NoOpenTransaction

# `VERIFY` — every check a COMMIT runs, and then the work is discarded. The
# third thing to do with an open transaction: COMMIT checks and keeps, CANCEL
# discards without checking, because every check that refuses a write runs
# inside the commit.

--- case: a write that would be accepted is rehearsed
BEGIN;
DEFINE COLLECTION drafts;
CREATE drafts:1 = { title: 'a draft' };
VERIFY;
--- expect: ok

--- case: and the rehearsal wrote nothing, not even the collection
SELECT * FROM drafts;
--- expect: error Unknown

--- case: a write that would be refused is refused by the rehearsal
BEGIN;
DEFINE TABLE notes (body string);
CREATE notes:1 = { body: 'here', author: 'ada' };
VERIFY;
--- expect: error UndeclaredField

--- case: a VERIFY with nothing open is refused, exactly as its siblings are
VERIFY;
--- expect: error NoOpenTransaction

--- case: a space and a table commit together, because a database is the unit
BEGIN;
DEFINE SPACE sessions;
SET sessions:'abc' = users:1;
CREATE users:3 = { name: 'hopper' };
COMMIT;
SELECT * FROM users;
--- expect: rows 2

# `BACKUP` — the store's log as a backup file, asked of the node that holds it.
# The one statement whose scope is the store rather than the selected namespace,
# which is why it needs an owner: there is no table for a grant to name.

--- case: a node hands over its whole log
BACKUP;
--- expect: ok

--- case: and the part of it since a sequence
BACKUP FROM 2;
--- expect: ok

--- case: FROM takes a sequence and says so when it does not get one
BACKUP FROM soon;
--- expect: error UnexpectedToken
