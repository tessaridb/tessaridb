DEFINE NAMESPACE fixture;
USE NAMESPACE fixture;
DEFINE DATABASE main;
USE DATABASE main;
DEFINE TABLE people SCHEMALESS;
DEFINE FIELD name ON people TYPE string;
DEFINE FIELD age ON people TYPE int;
DEFINE INDEX by_age ON people FIELDS age;
DEFINE INDEX by_name ON people FIELDS name UNIQUE;
CREATE people:1 = { name: 'ada', age: 36, tags: ['math', 'engines'] };
CREATE people:2 = { name: 'grace', age: 85, tags: ['compilers'] };
CREATE people:3 = { name: 'alan', age: 41 };
UPDATE people:3 MERGE { age: 42 };
CREATE people:4 = { name: 'gone', age: 1 };
DELETE people:4;
DEFINE ANALYZER english FILTERS lowercase, ascii, stemmer;
DEFINE COLLECTION notes;
DEFINE FIELD body ON notes TYPE string ANALYZER english;
DEFINE INDEX by_body ON notes FIELDS body SEARCH;
CREATE notes:1 = { body: 'Engines of thought compute numbers' };
CREATE notes:2 = { body: 'Compilers translate programs' };
CREATE notes:3 = { body: 'The engine computes' };
DEFINE VECTOR embeddings DIMENSION 3 DISTANCE cosine;
CREATE embeddings:1 = { vector: [1.0, 0.0, 0.0] };
CREATE embeddings:2 = { vector: [0.0, 1.0, 0.0] };
CREATE embeddings:3 = { vector: [0.9, 0.1, 0.0] };
DEFINE GEO places;
CREATE places:1 = { geometry: geometry { type: 'Point', coordinates: [2.35, 48.85] } };
CREATE places:2 = { geometry: geometry { type: 'Point', coordinates: [-0.12, 51.5] } };
CREATE places:3 = { geometry: geometry { type: 'Polygon', coordinates: [[[2, 48], [3, 48], [3, 49], [2, 49], [2, 48]]] } };
DEFINE TABLE knows EDGE;
RELATE people:1->knows->people:2;
RELATE people:2->knows->people:3;
DEFINE SPACE cache;
SET cache:'mode' = 'on';
INCR cache:'hits' BY 3;
DEFINE BUCKET media;
PUT media:'/logo.png' = 0x89504e47;
DEFINE QUEUE jobs TIMEOUT 30s ATTEMPTS 5;
CREATE jobs:1 = { url: 'https://example.test/a' };
CREATE jobs:2 = { url: 'https://example.test/b' };
DEFINE TOPIC events;
CREATE events = { kind: 'created' };
CREATE events = { kind: 'updated' };
DEFINE SERIES readings RETAIN 3650d TIME at;
CREATE readings = { at: datetime '2026-01-01T00:10:00Z', sensor: 'a', v: 1.5 };
CREATE readings = { at: datetime '2026-01-01T00:20:00Z', sensor: 'a', v: 2.25 };
CREATE readings = { at: datetime '2026-01-01T01:05:00Z', sensor: 'b', v: 4 };
DEFINE ROLLUP hourly FROM readings WINDOW 1h BY sensor COMPUTE count(*) AS n, sum(v) AS total, max(v) AS high RETAIN 3650d;
CREATE readings = { at: datetime '2026-01-01T00:30:00Z', sensor: 'a', v: 0.25 };
DEFINE VIEW adults MATERIALIZED AS SELECT name, age FROM people WHERE age > 40;
DEFINE VIEW by_tag MATERIALIZED AS SELECT age, count(*) AS n FROM people GROUP BY age;
