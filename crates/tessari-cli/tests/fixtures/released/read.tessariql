USE NAMESPACE fixture;
USE DATABASE main;
SELECT * FROM people ORDER BY id;
SELECT name FROM people WHERE age > 40 ORDER BY name;
SELECT * FROM people WHERE name = 'grace';
SELECT id FROM notes WHERE body MATCHES 'engine' ORDER BY id;
SELECT id FROM notes WHERE body MATCHES 'compiler' ORDER BY id;
SELECT id FROM embeddings ORDER BY vector::cosine(vector, [1.0, 0.0, 0.0]) DESC LIMIT 2;
SELECT id FROM places WHERE geo::intersects(geometry, geometry { type: 'Point', coordinates: [2.35, 48.85] }) ORDER BY id;
SELECT * FROM people:1->knows->people;
GET cache:'mode';
GET cache:'hits';
READ media:'/logo.png';
SELECT * FROM jobs ORDER BY id;
READ FROM events;
SELECT sensor, v FROM readings ORDER BY at;
SELECT sensor, n, total, high FROM hourly ORDER BY window, sensor;
SELECT name, age FROM adults ORDER BY name;
SELECT age, n FROM by_tag ORDER BY age;
